                            '🔗 LID se bhi kaam karta hai: /rmadmin 175192168992997'
                        ], '🗑️'));
                        break;
                    }
                    // 🔗 LID remover system: number aur LID dono forms try karo
                    const rmCandidates = removalCandidateJids(rmDigits);
                    const rmRoles = getTenantRoles(targetTenant);
                    const beforeAdmins = rmRoles.admins.length;
                    rmRoles.admins = rmRoles.admins.filter(a => !rmCandidates.some(c => jidEquals(a, c)));
                    let removedScope = '';
                    if (rmRoles.admins.length !== beforeAdmins) removedScope = 'admin';
                    else {
                        const beforeSubs = rmRoles.subAdmins.length;
                        rmRoles.subAdmins = rmRoles.subAdmins.filter(s => !rmCandidates.some(c => jidEquals(s, c)));
                        if (rmRoles.subAdmins.length !== beforeSubs) removedScope = 'sub';
                    }
                    saveTenantRoles(targetTenant);
                    if (removedScope === 'admin') {
                        await this.sendMessage(chatId, this.card('Admin Removed', [
                            '👤 Console: ' + targetTenant,
                            '📱 Removed: ' + describeJid(rmCandidates[0]),
                            '👑 Remaining admins: ' + rmRoles.admins.length
                        ], '🗑️'));
                    } else if (removedScope === 'sub') {
                        await this.sendMessage(chatId, this.card('Sub-Admin Removed', [
                            '👤 Console: ' + targetTenant,
                            '📱 Removed: ' + describeJid(rmCandidates[0]),
                            '🔰 Remaining sub-admins: ' + rmRoles.subAdmins.length
                        ], '🗑️'));
                    } else {
                        await this.sendMessage(chatId, this.card('Not Found', [
