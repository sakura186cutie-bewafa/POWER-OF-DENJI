            // Long-polling is this bot's only Telegram mode, so a stale webhook
            // (from an old host/deploy) would block every getUpdates call with
            // 409 Conflict. Clear it once at boot - always (hardcoded behavior).
            await this.api('deleteWebhook', {}, 15000).catch(() => {});
            await this.installCommandMenu();
            this.running = true;
            console.log(`✅ Telegram control online: @${this.botInfo.username || this.botInfo.first_name}`);
            this.pollLoop().catch(error => console.error('[TELEGRAM POLL FATAL]', error.message));
