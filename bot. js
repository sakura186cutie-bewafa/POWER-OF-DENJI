            case '/cancel': {
                // /cancel = stopall only: every running command stops AT ONCE.
                // Session stays OPEN — user can keep sending commands.
                const raid = this.raidSessions.get(id);
                const stopped = [];
                if (raid && raid.chosen && raid.chosen.length && raid.groupJid) {
                    const stopCmd = this.remoteCommandPrefix(id) + 'stopall';
                    for (const bot of raid.chosen) {
                        if (!bot?.sock || !bot.connected) continue;
                        const label = this.botLabel(bot);
                        const res = await this.executeRemoteCommand(bot, raid.groupJid, stopCmd, id);
                        stopped.push(`${label}: ${res}`);
                    }
                }
                const lines = ['🛑 stopall fired — ALL running commands stopped at once.'];
                if (stopped.length) {
                    lines.push('');
                    stopped.forEach(s => lines.push(`   ${s}`));
                } else {
                    lines.push('ℹ️ No running commands found for this raid group.');
                }
                lines.push('', '✅ Control session is STILL OPEN — send new commands anytime.',
                    'Use /done to stop everything and close the control session.',
                    '',
                    '🤖 WhatsApp numbers stay ONLINE — nothing is disconnected.');
                await this.sendMessage(chatId, this.card('All Stopped', lines, '🛑'));
                break;
            }

            case '/stopraid':
            case '/done': {
                // /done = stop everything running, then close the session.
                const raid = this.raidSessions.get(id);
                const stopped = [];
                if (raid && raid.chosen && raid.chosen.length && raid.groupJid) {
                    const stopCmd = this.remoteCommandPrefix(id) + 'stopall';
                    for (const bot of raid.chosen) {
                        if (!bot?.sock || !bot.connected) continue;
                        const label = this.botLabel(bot);
                        const res = await this.executeRemoteCommand(bot, raid.groupJid, stopCmd, id);
                        stopped.push(`${label}: ${res}`);
                    }
                }
                this.raidSessions.delete(id);
                this.groupListSessions.delete(id);
                const lines = ['✅ Remote control session closed.'];
                if (stopped.length) {
                    lines.push('', '🛑 stopall fired — every running command was stopped:');
                    stopped.forEach(s => lines.push(`   ${s}`));
                }
                lines.push('', 'Use /raid to start a new session.',
                    '',
                    '🤖 WhatsApp numbers stay ONLINE — nothing is disconnected.');
                await this.sendMessage(chatId, this.card('Session Closed', lines, '✅'));
                break;
            }

            case '/groups': {
                await this.sendMessage(chatId, this.card('Fetching Groups', ['⏳ Fetching groups from all your bots...'], '🔎'));
                const groups = await this.listTenantGroups(id);
                if (!groups.length) {
                    await this.sendMessage(chatId, this.card('No Groups', [
                        '📭 No groups found.',
                        'Make sure your bots are connected first (/status).'
                    ], '❌'));
                    break;
                }
                this.groupListSessions.set(id, { groups, timestamp: Date.now() });
                const lines = [];
                groups.forEach((g, i) => {
                    lines.push(`${i + 1}. ${g.subject}`);
                    lines.push(`   ${g.jid.split('@')[0]} • 🤖 ${g.bots.join(',')}`);
                });
                lines.push('', '🚀 Run: /run <number> <command>');
                await this.sendMessage(chatId, this.card('All Groups', lines, '📋'));
                break;
            }

            case '/run': {
                const gl = this.groupListSessions.get(id);
                const num = parseInt(args[0] || '', 10);
                const cmdText = args.slice(1).join(' ').trim();
                if (!gl?.groups?.length || !Number.isFinite(num) || num < 1 || num > gl.groups.length || !cmdText) {
                    await this.sendMessage(chatId, this.card('Run Command', [
                        'Usage: /run <group_number> <command>',
                        'Run /groups first, then pick a group number.',
                        'Example: /run 4 .nc1 hello 5000'
                    ], '⚡'));
                    break;
                }
                const group = gl.groups[num - 1];
                const results = [];
                for (const bot of this.manager.getTenantBots(id)) {
                    if (!bot?.sock || !bot.connected) continue;
                    if (!(await this.isBotInGroup(bot, group.jid))) continue;
                    results.push(`${this.botLabel(bot)}: ${await this.executeRemoteCommand(bot, group.jid, cmdText, id)}`);
                }
                if (!results.length) results.push('❌ No bot is a member of this group.');
                await this.sendMessage(chatId, this.card('Run Result', [
                    `👥 ${group.subject}`,
                    `➤ ${cmdText}`,
                    '',
                    ...results
                ], '⚡'));
                break;
            }

            default:
                await this.sendMessage(chatId, this.card('Unknown Command', [
                    'Use /menu to open the control panel.'
                ], '❔'), { reply_markup: this.menuKeyboard(this.isOwner(id)) });
        }
    }
}

// ==================== 🔄 UNIVERSAL KEEP-ALIVE SYSTEM (Railway/Render/VPS/Windows) ====================
// Render Free web services spin down after ~15 min without inbound traffic.
// This block adds:
//   1) A tiny HTTP server bound to process.env.PORT (Railway + Render inject it; default 3000)
//   2) A /health endpoint for UptimeRobot (free monitors hit it every 5 min,
//      so the instance NEVER sleeps) — also serves '/' and '/ping'
//   3) An optional self-ping loop (fallback when no external monitor is used)
//   4) Optional periodic GC to keep the 512MB heap tidy
// Env vars:
//   PORT                     -> Render injects this automatically (default 3000)
//   RENDER_EXTERNAL_URL      -> https://<your-service>.onrender.com (auto set)
//   PUBLIC_URL / KEEPALIVE_URL -> self-ping target fallbacks
//   KEEPALIVE_INTERVAL_MS    -> self-ping interval (default 60000 ms)
//   SELF_PING=off            -> disables the self-ping loop (UptimeRobot only)
//   AUTO_GC=1                -> periodic gc (run with: node --expose-gc index.js)

let keepAliveServer = null;
let keepAliveManager = null;
let keepAliveStartedAt = 0;
let lastSelfPingOk = null;

function startKeepAliveServer(managerRef) {
    if (keepAliveServer) return keepAliveServer;
    keepAliveManager = managerRef || null;
    keepAliveStartedAt = Date.now();
    const port = Math.max(1, Number(process.env.PORT) || 3000);
    const started = new Date().toISOString();
    keepAliveServer = http.createServer((req, res) => {
        try {
            const route = String(req.url || '/').split('?')[0];
            res.setHeader('Access-Control-Allow-Origin', '*');
            res.setHeader('Cache-Control', 'no-store');
            if (route === '/health' || route === '/' || route === '/ping') {
                const mem = process.memoryUsage();
                const payload = {
                    ok: true,
                    service: 'DENJI X PRIME V27',
                    time: new Date().toISOString(),
                    started,
                    uptimeSec: Math.floor(process.uptime()),
                    node: process.version,
                    memory: {
                        heapUsedMb: Number((mem.heapUsed / 1048576).toFixed(1)),
                        rssMb: Number((mem.rss / 1048576).toFixed(1))
                    },
                    fleet: { tenants: 0, connected: 0, total: 0 }
                };
                try {
                    if (keepAliveManager && typeof keepAliveManager.getTenantIds === 'function') {
                        const ids = keepAliveManager.getTenantIds();
                        let connected = 0;
                        let total = 0;
                        for (const id of ids) {
                            const bots = (typeof keepAliveManager.getTenantBots === 'function'
                                ? keepAliveManager.getTenantBots(id)
                                : null) || [];
                            total += bots.length;
                            connected += bots.filter(b => b && b.connected).length;
                        }
                        payload.fleet = { tenants: ids.length, connected, total };
                    }
                } catch (e) { /* fleet stats are best-effort */ }
                res.writeHead(200, { 'Content-Type': 'application/json' });
                res.end(JSON.stringify(payload));
                return;
            }
            res.writeHead(200, { 'Content-Type': 'text/plain' });
            res.end('ok');
        } catch (e) {
            try { res.writeHead(500, { 'Content-Type': 'text/plain' }); res.end('error'); } catch (e2) { /* noop */ }
        }
    });
    keepAliveServer.on('error', err => {
        console.error('[KEEP-ALIVE] HTTP server error:', err && err.message);
    });
    keepAliveServer.listen(port, '0.0.0.0', () => {
        console.log('[KEEP-ALIVE] HTTP server listening on 0.0.0.0:' + port);
        console.log('[KEEP-ALIVE] UptimeRobot URL: /health  (200 = alive)');
    });
    return keepAliveServer;
}

function startSelfPingLoop() {
    if (String(process.env.SELF_PING || '').toLowerCase() === 'off') return;
    const target = String(process.env.RENDER_EXTERNAL_URL || process.env.PUBLIC_URL
        || process.env.RAILWAY_PUBLIC_DOMAIN || process.env.KEEPALIVE_URL || '').trim().replace(/\/+$/, '');
    const interval = Math.max(30000, Number(process.env.KEEPALIVE_INTERVAL_MS) || 60000);
    if (!target) {
        console.log('[KEEP-ALIVE] Self-ping off — no RENDER_EXTERNAL_URL / RAILWAY_PUBLIC_DOMAIN / PUBLIC_URL set. Use UptimeRobot on /health instead.');
        return;
    }
    const hit = async () => {
        try {
            const res = await fetch(target + '/health', { signal: AbortSignal.timeout(8000) });
            lastSelfPingOk = res && res.ok ? new Date().toISOString() : null;
        } catch (e) {
            lastSelfPingOk = null;
        }
    };
    hit();
    setInterval(hit, interval);
    console.log('[KEEP-ALIVE] Self-ping every ' + interval + 'ms -> ' + target + '/health');
}

function startAutoGcLoop() {
    if (String(process.env.AUTO_GC || '').toLowerCase() !== '1') return;
    if (typeof global.gc !== 'function') {
        console.log('[KEEP-ALIVE] AUTO_GC=1 needs node --expose-gc');
        return;
    }
    setInterval(() => { try { global.gc(); } catch (e) { /* noop */ } }, 5 * 60 * 1000);
    console.log('[KEEP-ALIVE] Auto GC every 5 minutes (node --expose-gc)');
}

