    if (left === right) return true;
    // 🔄 Mapping-aware: same bande ka LID aur phone number ek hi identity mane
    const lk = roleIdentityKey(left);
    const rk = roleIdentityKey(right);
    return Boolean(lk && rk && lk === rk && lk.startsWith('p:'));
}
