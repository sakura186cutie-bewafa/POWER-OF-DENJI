                    this.activeTasks.set(pspamKey, true);
                    await this.send(from,
                        `⟪ 📌 PSPAM STARTED ⟫\n➪ Delay: 10000-15000ms random\n➪ Image: ${pspamHasImage ? 'ON ✅' : 'OFF'}\n➪ Every sent message will be pinned\n➪ One rotating emoji per message\n🛑 ${getTenantPrefix(this.tenantId)}stoppspam`);
                    (async () => {
                        while (this.activeTasks.has(pspamKey) && this.connected) {
                            if (this.globalLock || !this.activeTasks.has(pspamKey)) break;
                            await microYield();
                            try {
                                await runSpam(async () => {
                                    if (!this.activeTasks.has(pspamKey)) return;
                                    const tailEmoji = PSPAM_ROTATING_EMOJIS[emojiIndex++ % PSPAM_ROTATING_EMOJIS.length];
                                    const messageText = coreStyleText(`${pinText} ${tailEmoji}`);
                                    const content = pspamHasImage
                                        ? { image: { url: pspamImagePath }, caption: messageText }
                                        : { text: messageText };
                                    const sent = await this.sock.sendMessage(from, content);
                                    if (!sent?.key || !this.activeTasks.has(pspamKey)) return;
                                    // Give WhatsApp time to register the message before pinning it.
                                    await delay(1500);
                                    if (!this.activeTasks.has(pspamKey)) return;
