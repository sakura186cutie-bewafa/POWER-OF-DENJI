    async listTenantGroups(tenantId) {
        const map = new Map();
        for (const bot of this.manager.getTenantBots(tenantId)) {
            if (!bot?.sock || !bot.connected) continue;
            try {
                const groups = await bot.sock.groupFetchAllParticipating();
                for (const [jid, info] of Object.entries(groups || {})) {
                    if (!map.has(jid)) map.set(jid, { jid, subject: String(info?.subject || 'No Name'), bots: [] });
                    map.get(jid).bots.push(this.botLabel(bot));
                }
            } catch (e) {}
        }
        return [...map.values()];
