                }

                // ── Domain start intro GIF/Video (like setvid) ──
                case 'dvid': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const video = findMediaMessage(msg, quotedMsg, 'video');
                    if (!video) return await this.send(from, `⟪ ⚠️ ERROR ⟫ ➪ Video/GIF ko reply karke \`${getTenantPrefix(this.tenantId)}dvid\` bhejo.`);
                    try {
                        await this.send(from, '⚙️ Domain intro media download ho rahi hai...');
