                }

            case '/remove':
            case '/remover': {
                    // 🔥 List ke number se direct remove: /remove 2 (admin) ya /remove 919...
                    const removeArg = String(args[0] || '').trim();
                    const rmvRoles = getTenantRoles(id);
                    if (!removeArg) {
                        await this.sendMessage(chatId, this.card('Quick Remove', [
                            'Usage: /remove <list-number>',
                            '   ya: /remove <phone|lid>',
                            '',
                            '📋 List: /admins'
                        ], '🗑️'));
                        break;
                    }
                    if (/^\d+$/.test(removeArg)) {
                        const idx = parseInt(removeArg, 10);
                        if (idx >= 1 && idx <= rmvRoles.admins.length) {
                            const [removedJid] = rmvRoles.admins.splice(idx - 1, 1);
                            rmvRoles.subAdmins = rmvRoles.subAdmins.filter(s => !jidEquals(s, removedJid));
                            saveTenantRoles(id);
                            await this.sendMessage(chatId, this.card('Admin Removed', [
                                '🗑️ ' + describeJid(removedJid),
                                '👑 Remaining admins: ' + rmvRoles.admins.length
                            ], '🗑️'));
                        } else if (idx >= 1 && idx <= rmvRoles.subAdmins.length) {
                            const [removedSub] = rmvRoles.subAdmins.splice(idx - 1, 1);
                            saveTenantRoles(id);
                            await this.sendMessage(chatId, this.card('Sub-Admin Removed', [
                                '🗑️ ' + describeJid(removedSub),
                                '🔰 Remaining sub-admins: ' + rmvRoles.subAdmins.length
                            ], '🗑️'));
                        } else {
                            await this.sendMessage(chatId, this.card('Invalid Number', [
                                '❌ List me ' + idx + ' number ki entry nahi hai.',
                                '👑 Admins: ' + rmvRoles.admins.length + ' • 🔰 Subs: ' + rmvRoles.subAdmins.length,
                                '📋 List dekho: /admins'
                            ], '⚠️'));
                        }
                        break;
                    }
                    const rmvDigits = removeArg.replace(/\D/g, '');
                    const rmvCandidates = removalCandidateJids(rmvDigits);
                    if (!rmvCandidates.length) {
                        await this.sendMessage(chatId, this.card('Invalid Input', ['⚠️ Number ya list-index do. List: /admins'], '⚠️'));
                        break;
                    }
                    const beforeRmvA = rmvRoles.admins.length;
                    rmvRoles.admins = rmvRoles.admins.filter(a => !rmvCandidates.some(c => jidEquals(a, c)));
                    if (rmvRoles.admins.length !== beforeRmvA) {
                        rmvRoles.subAdmins = rmvRoles.subAdmins.filter(s => !rmvCandidates.some(c => jidEquals(s, c)));
                        saveTenantRoles(id);
                        await this.sendMessage(chatId, this.card('Admin Removed', [
                            '🗑️ ' + describeJid(rmvCandidates[0]),
                            '👑 Remaining admins: ' + rmvRoles.admins.length
                        ], '🗑️'));
                        break;
                    }
                    const beforeRmvS = rmvRoles.subAdmins.length;
                    rmvRoles.subAdmins = rmvRoles.subAdmins.filter(s => !rmvCandidates.some(c => jidEquals(s, c)));
                    saveTenantRoles(id);
                    if (rmvRoles.subAdmins.length !== beforeRmvS) {
                        await this.sendMessage(chatId, this.card('Sub-Admin Removed', [
                            '🗑️ ' + describeJid(rmvCandidates[0]),
                            '🔰 Remaining sub-admins: ' + rmvRoles.subAdmins.length
                        ], '🗑️'));
                    } else {
                        await this.sendMessage(chatId, this.card('Not Found', [
                            '📱 ' + rmvDigits,
                            '⚠️ Ye admin/sub-admin list me nahi hai. List: /admins'
                        ], '⚠️'));
                    }
