            case '/rmadmin': {
                    const isOwnerGlobal = this.isOwner(id) && args.length >= 2 && /^\d{5,20}$/.test(String(args[0]));
                    const targetTenant = isOwnerGlobal ? String(args[0]) : id;
                    const rmRaw = String(isOwnerGlobal ? args[1] : args[0] || '');
                    const rmDigits = rmRaw.replace(/\D/g, '');
                    if (!/^\d{8,20}$/.test(rmDigits)) {
                        await this.sendMessage(chatId, this.card('Remove Admin', [
                            this.isOwner(id) ? 'Usage: /rmadmin <phone|lid> OR /rmadmin <userId> <phone|lid>' : 'Usage: /rmadmin <phone|lid>',
