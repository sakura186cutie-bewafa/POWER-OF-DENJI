        const raw = String(text || '').trim();
        const m = raw.match(/chat\.whatsapp\.com\/([A-Za-z0-9_-]{10,})/i);
        if (m) return m[1];
        if (/^[A-Za-z0-9_-]{10,32}$/.test(raw) && !/^\d{5,20}$/.test(raw)) return raw;
        return null;
