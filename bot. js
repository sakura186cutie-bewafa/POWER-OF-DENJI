function registerLidMapping(a, b) {
    try {
        const na = normalizeJid(a);
        const nb = normalizeJid(b);
        if (!na || !nb || na === nb) return false;
        let lidUser = '', phoneUser = '';
        if (na.includes('@lid') && nb.endsWith('@s.whatsapp.net')) { lidUser = jidUserPart(na); phoneUser = jidUserPart(nb); }
        else if (nb.includes('@lid') && na.endsWith('@s.whatsapp.net')) { lidUser = jidUserPart(nb); phoneUser = jidUserPart(na); }
        // Sirf valid digits wali mapping accept karo (bogus jids se bacho)
        if (!lidUser || !phoneUser) return false;
        if (!/^\d{8,20}$/.test(lidUser) || !/^\d{8,20}$/.test(phoneUser)) return false;
        // Pehla consistent mapping hi final — overwrite se duplicate/corrupt map nahi bane
        if (LID_PHONE_MAP.lid[lidUser] && LID_PHONE_MAP.lid[lidUser] !== phoneUser) return false;
        if (LID_PHONE_MAP.rev[phoneUser] && LID_PHONE_MAP.rev[phoneUser] !== lidUser) return false;
        if (LID_PHONE_MAP.lid[lidUser] === phoneUser && LID_PHONE_MAP.rev[phoneUser] === lidUser) return false;
        LID_PHONE_MAP.lid[lidUser] = phoneUser;
        LID_PHONE_MAP.rev[phoneUser] = lidUser;
        saveLidMapSoon();
        return true;
    } catch (e) { return false; }
}
function roleIdentityKey(jid) {
