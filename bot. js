const MAX_SONG_BYTES = Math.max(1, Number(process.env.MAX_SONG_MB || 25)) * 1024 * 1024;

function songDuration(seconds) {
    const n = Math.max(0, Number(seconds) || 0);
    return n ? `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}` : '\u2014';
}
function cleanSongFileName(value) {
