function raidFitCompose(head, unit, unitMax, tail) {
    const cap = RAID_SUBJECT_LIMIT;
    let R = unitMax;
    const tryR = r => head + unit.repeat(r) + tail;
    while (R > 1 && countGraphemes(tryR(R)) > cap) R--;
