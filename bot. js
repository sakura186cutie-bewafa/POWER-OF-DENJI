                    else if (fs.existsSync(ariseImage)) await this.safeSendMessage(from, { image: fs.readFileSync(ariseImage), caption: ariseText }, { quoted: msg });
                    else await this.safeSendMessage(from, { text: ariseText }, { quoted: msg });
