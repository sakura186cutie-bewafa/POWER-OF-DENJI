    async pollLoop() {
        let retryDelay = 2000;
        while (this.running) {
            try {
                const updates = await this.api('getUpdates', {
                    offset: this.access.lastUpdateId + 1,
                    timeout: 30,
                    allowed_updates: ['message', 'callback_query']
                }, 90000);
                retryDelay = 2000;
                for (const update of updates || []) {
                    this.access.lastUpdateId = Math.max(this.access.lastUpdateId, Number(update.update_id) || 0);
                    this.saveAccess();
                    try { await this.handleUpdate(update); }
                    catch (error) { console.error('[TELEGRAM UPDATE]', error.message); }
                }
            } catch (error) {
            const isTransient = error.name === 'AbortError' || error.message.includes('timeout') || error.message.includes('fetch failed') || error.message.includes('Bad Gateway');
            if (!isTransient) console.error('[TELEGRAM POLL]', error.message);
            await delay(retryDelay);
            retryDelay = Math.min(15000, retryDelay * 2);
        }
        }
    }

