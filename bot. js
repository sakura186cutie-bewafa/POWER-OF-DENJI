                        await this.send(from, DEV_CARD('Domain Media Type', [
                            '✅ Media download ho gaya!',
                            '',
                            '1️⃣ Video (🎵 audio ke saath)',
                            '2️⃣ Animation (🎞️ GIF)',
                            '',
                            'Reply karein `1` ya `2`'
