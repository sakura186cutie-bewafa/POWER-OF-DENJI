/** Resolve LID / mixed identities into a proper mentionable WhatsApp target. */
async function resolveMentionTarget(sock, groupJid, jidOrJids, fallbackName = 'Target') {
    const incoming = (Array.isArray(jidOrJids) ? jidOrJids : [jidOrJids])
        .map(normalizeJid)
        .filter(Boolean);
    if (!incoming.length) {
        return { jid: '', tag: '@user', name: String(fallbackName || 'Target'), mentionJids: [] };
    }

    let phone = incoming.find(j => j.endsWith('@s.whatsapp.net')) || '';
    let lid = incoming.find(j => j.includes('@lid')) || '';
    let name = String(fallbackName || '').trim();
    let matchedAliases = [...incoming];

    try {
        if (sock && String(groupJid || '').endsWith('@g.us')) {
            const meta = await sock.groupMetadata(groupJid);
            for (const p of meta.participants || []) {
                const aliases = participantAliasJids(p);
                const hit = aliases.some(alias =>
                    incoming.some(id => jidEquals(alias, id) || jidUserPart(alias) === jidUserPart(id))
                );
                if (!hit) continue;
                matchedAliases = [...new Set([...matchedAliases, ...aliases])];
                phone = preferredMentionJid(matchedAliases.filter(j => j.endsWith('@s.whatsapp.net'))) || phone;
                lid = matchedAliases.find(j => j.includes('@lid')) || lid;
                name = name || p.notify || p.name || p.pushname || p.verifiedName || '';
                break;
            }
        }
    } catch (e) {}

    const best = preferredMentionJid([phone, lid, ...matchedAliases, ...incoming]);
    const mentionJids = [...new Set([best, phone, lid, ...incoming].map(normalizeJid).filter(Boolean))];
    const tagJid = phone || best;
    const tag = mentionAtTag(tagJid);
    if (!name) name = jidUserPart(phone || best) || 'Target';
    return { jid: best, tag, name, mentionJids };
}

