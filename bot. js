// ⏱️ Ranged-delay helpers: "arc Rahul 5000" → 4000-5000ms random, "100" → 90-100ms,
// "10000" → 9000-10000ms. No number = command ka apna default random delay.
function extractTrailingDelayMs(inputText) {
    const parts = String(inputText || '').split(/\s+/);
    const tail = parts.length > 1 ? parts[parts.length - 1] : '';
    const num = /^\d+$/.test(tail) ? parseInt(tail, 10) : NaN;
    if (Number.isFinite(num) && num >= 5) {
        parts.pop();
        return { text: parts.join(' ').trim(), base: num };
    }
    return { text: String(inputText || '').trim(), base: null };
}
function arcDelayRange(baseMs) {
    const N = Math.max(5, Math.floor(Number(baseMs) || 0));
    const lo = N < 1000 ? Math.max(5, Math.round(N * 0.9)) : Math.max(50, N - 1000);
    return { lo, hi: N };
}
function rangedDelayFor(baseMs) {
    const r = arcDelayRange(baseMs);
    return r.lo + Math.floor(Math.random() * (r.hi - r.lo + 1));
}
function arcDelayLabel(baseMs) {
    const r = arcDelayRange(baseMs);
    return `${r.lo}-${r.hi}ms`;
}

async function resolveRaidTarget(sock, groupJid, rawText, extraJids = []) {
    const rawClean = String(rawText || '').trim().replace(/^@/, '');
    const incoming = [...new Set((extraJids || []).map(normalizeJid).filter(Boolean))];
    const typedDigits = rawClean.replace(/\D/g, '');
    if (/^\d{7,20}$/.test(typedDigits)) incoming.push(phoneToJid(typedDigits));
    let best = preferredMentionJid(incoming) || '';
    let name = '';
    try {
        if (sock && String(groupJid || '').endsWith('@g.us')) {
            const meta = await sock.groupMetadata(groupJid);
            const parts = (meta && meta.participants) || [];
            let hit = null;
            if (best) {
                hit = parts.find(p => participantAliasJids(p).some(a =>
                    jidEquals(a, best) || jidUserPart(a) === jidUserPart(best))) || null;
            }
            if (!hit && rawClean) {
                const q = rawClean.toLowerCase();
                hit = parts.find(p => {
                    const pn = String(p.pushName || p.name || p.notify || p.verifiedName || '').trim().toLowerCase();
                    if (!pn) return false;
                    return pn === q || pn.includes(q) || q.includes(pn);
                }) || null;
            }
            if (hit) {
                const al = participantAliasJids(hit);
                best = preferredMentionJid(al) || best || preferredMentionJid(incoming) || '';
                name = hit.pushName || hit.name || hit.notify || hit.verifiedName || '';
            }
        }
    } catch (e) {}
    if (!best) {
        return { jid: '', tag: '', name: String(rawText || '').trim(), mentionJids: [], matched: false };
    }
    const finalJids = [...new Set([best, ...incoming].map(normalizeJid).filter(Boolean))];
    return {
        jid: best,
        tag: mentionAtTag(best),
        name: name || String(rawText || '').trim(),
        mentionJids: finalJids,
        matched: true
    };
}


