                case 'off': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    this.isBotSleeping = true;
                    const stopped = this.purgeAllProcesses();
                    const offText = DEV_CARD('Sleep', [
                        '† Shadows returned to the abyss. †',
