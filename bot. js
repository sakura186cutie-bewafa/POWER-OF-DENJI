function dedupeRoleEntries(list) {
    if (!Array.isArray(list)) return [];
    const out = [];
    let changed = false;
    for (const jid of list) {
        const n = normalizeJid(jid);
        if (!n) { changed = true; continue; }
        const key = roleIdentityKey(n);
        const idx = out.findIndex(e => roleIdentityKey(e) === key);
        if (idx === -1) { out.push(n); continue; }
        changed = true;
        if (String(out[idx]).includes('@lid') && n.endsWith('@s.whatsapp.net')) out[idx] = n;
    }
    return changed ? out : list;
}
