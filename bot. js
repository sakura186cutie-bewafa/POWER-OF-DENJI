}
function makeSongSearchUrl(endpoint, query, limit) {
    const url = new URL(endpoint);
    url.searchParams.set('query', query);
    url.searchParams.set('limit', String(limit));
    return url.toString();
}
function normalizeSongResults(payload) {
    if (Array.isArray(payload)) return payload;
    if (Array.isArray(payload?.data?.results)) return payload.data.results;
    if (Array.isArray(payload?.data)) return payload.data;
    return [];
}
async function searchSongs(query, limit = 10) {
    const clean = String(query || '').trim();
    if (!clean) return [];
    const errors = [];
    for (const endpoint of SAAVN_SEARCH_ENDPOINTS) {
        try {
            const response = await fetch(makeSongSearchUrl(endpoint, clean, Math.max(1, Math.min(10, limit))), {
                headers: { 'Accept': 'application/json', 'User-Agent': 'DENJIXBot/Ubuntu24' },
                signal: AbortSignal.timeout(20000)
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const rows = normalizeSongResults(await response.json());
            const songs = rows.map((item, index) => {
                const downloads = Array.isArray(item?.downloadUrl) ? item.downloadUrl : [];
                const audioUrl = String(downloads.at(-1)?.url || downloads[0]?.url || item?.media_url || item?.download_url || '').trim();
                const imageList = Array.isArray(item?.image) ? item.image : [];
                const artist = item?.artists?.primary?.map?.(a => a?.name).filter(Boolean).join(', ')
                    || item?.primaryArtists || item?.singers || item?.artist || 'Unknown artist';
                return {
                    id: index + 1,
                    title: item?.name || item?.song || 'Unknown title',
                    artist,
                    album: item?.album?.name || item?.album || '',
                    year: item?.year || '',
                    duration: songDuration(item?.duration),
                    image: imageList.at(-1)?.url || imageList[0]?.url || item?.image || item?.thumbnail || '',
                    audioUrl
                };
            }).filter(song => Boolean(song.audioUrl));
            if (songs.length) return songs.slice(0, limit);
            errors.push(`${new URL(endpoint).host}: no playable results`);
        } catch (error) {
            errors.push(`${new URL(endpoint).host}: ${error?.cause?.code || error.message}`);
        }
    }
    throw new Error(`All Saavn search sources failed (${errors.join(' | ')})`);
}

async function downloadSongBuffer(url) {
    const response = await fetch(url, {
        headers: { 'Accept': 'audio/*,*/*;q=0.8', 'User-Agent': 'DENJIXBot/Ubuntu24' },
        signal: AbortSignal.timeout(90000)
    });
    if (!response.ok) throw new Error(`Song download HTTP ${response.status}`);
    const expected = Number(response.headers.get('content-length') || 0);
    if (expected > MAX_SONG_BYTES) throw new Error(`Song is larger than ${Math.round(MAX_SONG_BYTES / 1024 / 1024)} MB`);
    const reader = response.body?.getReader();
    if (!reader) throw new Error('Song response has no readable body');
    const chunks = [];
    let total = 0;
    try {
        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            total += value.byteLength;
            if (total > MAX_SONG_BYTES) throw new Error(`Song is larger than ${Math.round(MAX_SONG_BYTES / 1024 / 1024)} MB`);
            chunks.push(Buffer.from(value));
        }
    } finally { reader.releaseLock?.(); }
    if (total < 1000) throw new Error('Downloaded audio is empty or invalid');
    const type = response.headers.get('content-type') || '';
    return { buffer: Buffer.concat(chunks), mimetype: /mp4|m4a|aac/i.test(type) ? 'audio/mp4' : 'audio/mpeg' };
}

