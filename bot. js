                    if (fs.existsSync(offVideo)) await this.safeSendMessage(from, { video: fs.readFileSync(offVideo), caption: offText, gifPlayback: offType === 'anim' }, { quoted: msg });
                    else if (fs.existsSync(offImage)) await this.safeSendMessage(from, { image: fs.readFileSync(offImage), caption: offText }, { quoted: msg });
