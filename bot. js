    async sendSessionLifecycle(session, type, details = {}) {
        if (!session?.tenantId) return;
        const phone = String(session.phoneNumber || session.sock?.user?.id?.split(':')[0] || 'Unknown').replace(/\D/g, '') || 'Unknown';
        const offlineSince = Number(details.offlineSince || session.offlineSince) || null;
        const autoDeleteAt = Number(details.autoDeleteAt || session.autoDeleteAt) || null;
        const code = details.code ?? session.lastDisconnectCode ?? 'N/A';
        const reason = details.reason || session.lastDisconnectReason || 'Unknown';
        const lastUptime = session.connectedAt && offlineSince
            ? formatDuration(Math.max(0, (offlineSince - session.connectedAt) / 1000))
            : 'N/A';
        const downtime = offlineSince
            ? formatDuration(Math.max(0, (Date.now() - offlineSince) / 1000))
            : 'N/A';

        let title = 'Session Update';
        let icon = 'ℹ️';
        let status = 'UPDATED';
        const lines = [
            `👤 Tenant: ${session.tenantId}`,
            `🤖 Session: ${session.internalId}`,
            `📱 Number: +${phone}`
        ];

        if (type === 'recovered') {
            title = 'Bot Reconnected';
            icon = '✅';
            status = 'CONNECTED';
            lines.push(
                `🟢 Status: ${status}`,
                `🧩 Previous code: ${code}`,
                `📝 Previous reason: ${reason}`,
                `📴 Downtime: ${downtime}`,
                `⏱️ Recovered at: ${this.formatTimestamp(Date.now())}`,
                '🛡️ Scheduled auto-deletion was cancelled.'
            );
        } else if (type === 'autoDeleted') {
            title = 'Session Auto-Deleted';
            icon = '🧹';
            status = 'DELETED';
            lines.push(
                `🗑️ Status: ${status}`,
                `🧩 Disconnect code: ${code}`,
                `📝 Reason: ${reason}`,
                `⏱️ Disconnected at: ${this.formatTimestamp(offlineSince)}`,
                `⌛ Deleted at: ${this.formatTimestamp(Date.now())}`,
                '🔐 Local authentication data was removed automatically.'
            );
        } else {
            const permanent = type === 'permanent';
            title = permanent ? 'Session Suspended / Logged Out' : 'Bot Disconnected';
            icon = permanent ? '🚨' : '⚠️';
            status = permanent ? 'PERMANENT FAILURE' : 'OFFLINE / RETRYING';
            lines.push(
                `${permanent ? '🔴' : '🟠'} Status: ${status}`,
                `🧩 Disconnect code: ${code}`,
                `📝 Reason: ${reason}`,
                `⏱️ Last connected uptime: ${lastUptime}`,
                `📴 Disconnected at: ${this.formatTimestamp(offlineSince)}`,
                `⌛ Recovery window: ${formatDuration(AUTO_DELETE_AFTER_MS / 1000)}`,
                `🧹 Auto-delete at: ${this.formatTimestamp(autoDeleteAt)}`,
                '',
                `Delete now: /delete ${session.internalId}`,
                permanent
                    ? 'This session will not reconnect unless it is paired again.'
                    : 'If the session reconnects, auto-deletion will be cancelled.'
            );
        }
        await this.sendMessage(session.tenantId, this.card(title, lines, icon));
    }

