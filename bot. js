// ==================== LOCAL TOOLING HELPERS (yt-dlp / ffmpeg / media) ====================
const IS_WINDOWS = process.platform === 'win32';
const STORE_DIR = './store';
const YT_STORE_DIR = `${STORE_DIR}/yt`;
const BIN_DIR = `${STORE_DIR}/bin`;
const YTDLP_BIN = `${BIN_DIR}/${IS_WINDOWS ? 'yt-dlp.exe' : 'yt-dlp'}`;
const FFMPEG_BIN = process.env.FFMPEG_PATH || `${BIN_DIR}/${IS_WINDOWS ? 'ffmpeg.exe' : 'ffmpeg'}`;
let ytDlpInstallAttempted = false;
let ffmpegInstallAttempted = false;

async function commandAvailable(command) {
    return await new Promise(resolve => {
        execFile(IS_WINDOWS ? 'where' : 'which', [command], { timeout: 5000 }, (error) => resolve(!error));
    });
}

async function resolveYtDlpBinary() {
    const envPath = process.env.YT_DLP_PATH || process.env.YTDLP_PATH;
    if (envPath && fs.existsSync(envPath)) return envPath;
    if (fs.existsSync(YTDLP_BIN)) return YTDLP_BIN;
    if (await commandAvailable(IS_WINDOWS ? 'yt-dlp.exe' : 'yt-dlp')) return IS_WINDOWS ? 'yt-dlp.exe' : 'yt-dlp';
    if (await commandAvailable('yt-dlp')) return 'yt-dlp';
    return null;
}

async function ensureYtDlp() {
    const existing = await resolveYtDlpBinary();
    if (existing) return existing;
    if (ytDlpInstallAttempted) return null;
    ytDlpInstallAttempted = true;
    try {
        fs.mkdirSync(BIN_DIR, { recursive: true });
        const downloadUrl = IS_WINDOWS
            ? 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe'
            : (process.arch === 'arm64'
                ? 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux_aarch64'
                : 'https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux');
        const response = await fetch(downloadUrl, {
            headers: { 'User-Agent': 'DENJIXBot/27' },
            signal: AbortSignal.timeout(120000)
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const buffer = Buffer.from(await response.arrayBuffer());
        if (buffer.length < 100000) throw new Error('yt-dlp download too small');
        fs.writeFileSync(YTDLP_BIN, buffer);
        if (!IS_WINDOWS) fs.chmodSync(YTDLP_BIN, 0o755);
        return YTDLP_BIN;
    } catch (e) {
        console.error('[yt-dlp install failed]', e.message);
        return null;
    }
}

function ensureYoutubeCookies() {
    const candidates = [
        process.env.YOUTUBE_COOKIES_FILE,
        process.env.YT_COOKIES_FILE,
        './store/cookies.txt',
        './data/youtube_cookies.txt',
        './youtube_cookies.txt',
        './cookies.txt'
    ].filter(Boolean);
    for (const file of candidates) {
        try {
            if (fs.existsSync(file) && fs.statSync(file).size > 20) return file;
        } catch (e) {}
    }
    return null;
}

function atomicWriteFile(path, data) {
    const dir = path.split('/').slice(0, -1).join('/') || '.';
    fs.mkdirSync(dir, { recursive: true });
    const tmp = `${path}.tmp-${Date.now()}-${Math.random().toString(36).slice(2)}`;
    fs.writeFileSync(tmp, data);
    fs.renameSync(tmp, path);
}

async function downloadMediaBuffer(mediaMessage, type = 'image', maxBytes = 25 * 1024 * 1024) {
    const stream = await downloadContentFromMessage(mediaMessage, type);
    let buffer = Buffer.from([]);
    for await (const chunk of stream) {
        buffer = Buffer.concat([buffer, chunk]);
        if (buffer.length > maxBytes) throw new Error(`Media too large. Limit ${(maxBytes / 1024 / 1024).toFixed(1)}MB`);
    }
    if (!buffer.length) throw new Error('Media download empty');
    return buffer;
}

async function ensureFfmpeg() {
    if (fs.existsSync(FFMPEG_BIN) || await commandAvailable('ffmpeg')) return true;
    if (ffmpegInstallAttempted) return false;
    ffmpegInstallAttempted = true;
    console.log('[ffmpeg] Missing. MP3 conversion will fall back to M4A.');
    return false;
}

async function convertBufferToMp3(inputBuffer, inputExt = 'bin') {
    fs.mkdirSync(YT_STORE_DIR, { recursive: true });
    const token = `cvt-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
    const input = `${YT_STORE_DIR}/${token}.${String(inputExt || 'bin').replace(/[^a-z0-9]/gi, '') || 'bin'}`;
    const output = `${YT_STORE_DIR}/${token}.mp3`;
    try {
        fs.writeFileSync(input, inputBuffer);
        // Already looks like mp3 — keep as-is when ffmpeg is missing.
        if (looksLikeAudio(inputBuffer, 'audio/mpeg') && inputExt.toLowerCase() === 'mp3') {
            return inputBuffer;
        }
        const ffmpegReady = await ensureFfmpeg();
        if (!ffmpegReady && looksLikeAudio(inputBuffer, 'audio/mpeg')) return inputBuffer;
        if (!ffmpegReady) throw new Error('ffmpeg missing — audio/video ko MP3 me convert nahi kar sakta');
        const ffmpeg = fs.existsSync(FFMPEG_BIN) ? FFMPEG_BIN : (IS_WINDOWS ? 'ffmpeg.exe' : 'ffmpeg');
        await new Promise((resolve, reject) => {
            execFile(ffmpeg, ['-y', '-i', input, '-vn', '-acodec', 'libmp3lame', '-b:a', '128k', output],
                { timeout: 120000, maxBuffer: 4 * 1024 * 1024 },
                (error, stdout, stderr) => error ? reject(new Error((stderr || error.message).toString().slice(-400))) : resolve());
        });
        const mp3 = fs.readFileSync(output);
        if (!mp3.length) throw new Error('MP3 conversion empty');
        return mp3;
    } finally {
        try { if (fs.existsSync(input)) fs.unlinkSync(input); } catch (e) {}
        try { if (fs.existsSync(output)) fs.unlinkSync(output); } catch (e) {}
    }
}

async function prepareWhatsAppAudio(mp3Buffer, wantVoiceNote = false) {
    if (!wantVoiceNote) return { buffer: mp3Buffer, mimetype: 'audio/mpeg', ptt: false, fileName: 'DENJI-tts.mp3' };
    const ffmpegReady = await ensureFfmpeg();
    if (!ffmpegReady) {
        // MP3 with ptt=true is rejected on some WhatsApp clients. Send it as a
        // normal playable audio attachment when Opus conversion is unavailable.
        return { buffer: mp3Buffer, mimetype: 'audio/mpeg', ptt: false, fileName: 'DENJI-voice.mp3' };
    }
    fs.mkdirSync(YT_STORE_DIR, { recursive: true });
    const token = `tts-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
    const input = `${YT_STORE_DIR}/${token}.mp3`;
    const output = `${YT_STORE_DIR}/${token}.ogg`;
    try {
        fs.writeFileSync(input, mp3Buffer);
        const ffmpeg = fs.existsSync(FFMPEG_BIN) ? FFMPEG_BIN : (IS_WINDOWS ? 'ffmpeg.exe' : 'ffmpeg');
        await new Promise((resolve, reject) => {
            execFile(ffmpeg, ['-y', '-i', input, '-vn', '-c:a', 'libopus', '-b:a', '64k', '-vbr', 'on', '-application', 'voip', output],
                { timeout: 60000, maxBuffer: 2 * 1024 * 1024 }, (error, stdout, stderr) =>
                    error ? reject(new Error((stderr || error.message).toString().slice(-300))) : resolve());
        });
        const opus = fs.readFileSync(output);
        if (!looksLikeAudio(opus, 'audio/ogg')) throw new Error('Opus conversion invalid');
        return { buffer: opus, mimetype: 'audio/ogg; codecs=opus', ptt: true, fileName: 'DENJI-voice.ogg' };
    } catch (e) {
        console.error('[TTS opus conversion]', e.message);
        return { buffer: mp3Buffer, mimetype: 'audio/mpeg', ptt: false, fileName: 'DENJI-voice.mp3' };
    } finally {
        try { if (fs.existsSync(input)) fs.unlinkSync(input); } catch (e) {}
        try { if (fs.existsSync(output)) fs.unlinkSync(output); } catch (e) {}
    }
}
async function sendTTSMessage(sock, jid, mp3Buffer, wantVoiceNote = false, quoted = null) {
    const audio = await prepareWhatsAppAudio(mp3Buffer, wantVoiceNote);
    return await sock.sendMessage(jid, {
        audio: audio.buffer,
        mimetype: audio.mimetype,
        ptt: audio.ptt,
        fileName: audio.fileName
    }, quoted ? { quoted } : {});
}

async function downloadWithYtDlp(url, format = 'mp3', useCookies = true) {
    fs.mkdirSync(YT_STORE_DIR, { recursive: true });
    const ytdlp = await ensureYtDlp();
    if (!ytdlp) throw new Error('yt-dlp local installation failed');

    const token = `audio-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
    const outputTemplate = `${YT_STORE_DIR}/${token}.%(ext)s`;
    const cookieFile = useCookies ? ensureYoutubeCookies() : null;
    const ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124 Safari/537.36';

    const args = [
        '--no-playlist', '--no-warnings', '--no-progress',
        '--socket-timeout', '20', '--retries', '3', '--fragment-retries', '3',
        '--js-runtimes', 'node',
        '--force-ipv4', '--user-agent', ua,
        '--extractor-args', 'youtube:player_client=android,web',
        '-f', format === 'mp3' ? 'bestaudio/best' : 'bestaudio[ext=m4a]/bestaudio/best',
        '-o', outputTemplate
    ];

    // Headless Ubuntu servers normally have no Chrome profile. Never force
    // --cookies-from-browser automatically; use an exported Netscape cookie
    // file when available, or an explicitly configured browser profile only.
    const cookieBrowser = useCookies ? String(process.env.YT_COOKIES_FROM_BROWSER || '').trim() : '';
    if (useCookies && cookieFile) {
        args.push('--cookies', cookieFile);
    } else if (useCookies && cookieBrowser) {
        args.push('--cookies-from-browser', cookieBrowser);
    }
    
    if (format === 'mp3') args.push('--extract-audio', '--audio-format', 'mp3', '--audio-quality', '128K');
    args.push(url);

    try {
        await new Promise((resolve, reject) => {
            execFile(ytdlp, args, { timeout: 180000, maxBuffer: 8 * 1024 * 1024 }, (error, stdout, stderr) => {
                if (error) return reject(new Error(`yt-dlp: ${(stderr || error.message).toString().slice(-800)}`));
                resolve();
            });
        });
        const file = fs.readdirSync(YT_STORE_DIR).find(name => name.startsWith(`${token}.`));
        if (!file) throw new Error('yt-dlp completed but output file was not found');
        const fullPath = `${YT_STORE_DIR}/${file}`;
        const buffer = fs.readFileSync(fullPath);
        if (buffer.length < 1000) throw new Error('yt-dlp returned an empty audio file');
        return { buffer, ext: file.split('.').pop().toLowerCase() };
    } finally {
        try {
            for (const name of fs.readdirSync(YT_STORE_DIR)) {
                if (name.startsWith(`${token}.`)) {
                    try { fs.unlinkSync(`${YT_STORE_DIR}/${name}`); } catch (e) {}
                }
            }
        } catch (e) {}
    }
}

async function searchYouTube(query, limit = 5) {
    const cleanQuery = String(query || '').trim();
    if (!cleanQuery) return [];

    // Primary: yt-search with a hard timeout.
    try {
        const result = await Promise.race([
            yts(cleanQuery),
            new Promise((_, reject) => setTimeout(() => reject(new Error('yt-search timeout')), 15000))
        ]);
        const videos = (result?.videos || []).slice(0, limit);
        if (videos.length) return videos;
    } catch (e) {
        console.error('[yt-search primary]', e.message);
    }

    // Fallback: yt-dlp's own search extractor.
    try {
        const binary = await ensureYtDlp();
        if (!binary) throw new Error('yt-dlp unavailable');
        const cookieFile = ensureYoutubeCookies();
        const args = ['--dump-single-json', '--flat-playlist', '--no-warnings', `ytsearch${limit}:${cleanQuery}`];
        if (cookieFile) args.unshift('--cookies', cookieFile);
        const stdout = await new Promise((resolve, reject) => {
            execFile(binary, args, { timeout: 45000, maxBuffer: 8 * 1024 * 1024 }, (error, out, err) => {
                if (error) return reject(new Error((err || error.message).toString().slice(-500)));
                resolve(out);
            });
        });
        const data = JSON.parse(stdout);
        return (data.entries || []).filter(Boolean).slice(0, limit).map(entry => ({
            title: entry.title || 'YouTube Video',
            url: entry.webpage_url || (entry.id ? `https://www.youtube.com/watch?v=${entry.id}` : entry.url),
            videoId: entry.id,
            timestamp: entry.duration_string || (entry.duration ? `${Math.floor(entry.duration / 60)}:${String(entry.duration % 60).padStart(2, '0')}` : '?'),
            seconds: entry.duration || 0,
            thumbnail: entry.thumbnail || entry.thumbnails?.at?.(-1)?.url || (entry.id ? `https://i.ytimg.com/vi/${entry.id}/hqdefault.jpg` : ''),
            author: { name: entry.channel || entry.uploader || 'Unknown' }
        })).filter(video => video.url);
    } catch (e) {
        console.error('[yt-search fallback]', e.message);
        return [];
    }
}

async function downloadAndSendAudio(sock, jid, url, videoMeta = null, quoted = null) {
    let audioBuffer = null;
    let audioExt = 'mp3';
    let usedSource = 'unknown';
    let lastError = null;

    // METHOD 1: yt-dlp (PRIMARY - most reliable in 2026)
    try {
        if (!await ensureYtDlp()) throw new Error('yt-dlp unavailable');
        // Try mp3 first (best UX)
        try {
            const dl = await downloadWithYtDlp(url, 'mp3');
            audioBuffer = dl.buffer;
            audioExt = dl.ext || 'mp3';
            usedSource = 'yt-dlp (mp3)';
        } catch (e1) {
            lastError = e1.message;
            const needsFfmpeg = e1.message.includes('ffmpeg') || e1.message.includes('Postprocessing') || e1.message.includes('empty output');
            if (needsFfmpeg && !fs.existsSync(FFMPEG_BIN)) {
                await ensureFfmpeg();
            }
            // Try m4a (no conversion needed)
            try {
                const dl = await downloadWithYtDlp(url, 'm4a');
                audioBuffer = dl.buffer;
                audioExt = dl.ext || 'm4a';
                usedSource = `yt-dlp (${audioExt})`;
            } catch (e2) {
                // Stale/invalid cookies can break extraction; retry M4A anonymously.
                try {
                    const dl = await downloadWithYtDlp(url, 'm4a', false);
                    audioBuffer = dl.buffer;
                    audioExt = dl.ext || 'm4a';
                    usedSource = `yt-dlp (${audioExt}, no-cookie retry)`;
                } catch (e3) {
                    lastError = `${e1.message} | ${e2.message} | ${e3.message}`;
                }
            }
        }
    } catch (e) {
        lastError = `yt-dlp: ${e.message?.substring(0, 150)}`;
    }
    const primaryYtDlpError = lastError;

    // METHOD 2: API fallbacks (in case yt-dlp fails completely)
    if (!audioBuffer) {
        const apis = [
            { name: 'Vreden High-Speed', url: `https://api.vreden.web.id/api/ytmp3?url=${encodeURIComponent(url)}`, parse: (d) => d.result?.download?.url || d.result?.url || d.url },
            { name: 'Sandip Cloud Node', url: `https://api.sandipbhetwal.com/api/ytmp3?url=${encodeURIComponent(url)}`, parse: (d) => d.url || d.result?.url },
            { name: 'Widipe Engine', url: `https://widipe.com/download/ytdl?url=${encodeURIComponent(url)}`, parse: (d) => d.result?.mp3 || d.result?.url }
        ];
        for (const api of apis) {
            try {
                const res = await fetch(api.url, {signal: AbortSignal.timeout(20000)});
                if (!res.ok) { lastError = `${api.name}: HTTP ${res.status}`; continue; }
                const contentType = res.headers.get('content-type') || '';
                let audioUrl = null;
                if (contentType.includes('audio')) {
                    audioBuffer = Buffer.from(await res.arrayBuffer());
                    usedSource = api.name + ' (direct)';
                    break;
                }
                const rawBody = await res.text();
                try {
                    const data = JSON.parse(rawBody);
                    audioUrl = api.parse(data);
                } catch (jsonErr) {
                    const body = rawBody.trim();
                    if (/^https?:\/\//i.test(body)) audioUrl = body;
                }
                if (!audioUrl) { lastError = `${api.name}: no URL`; continue; }
                if (audioUrl) {
                    const ar = await fetch(audioUrl, { headers: { 'User-Agent': 'DENJIXBot/27' }, signal: AbortSignal.timeout(60000)});
                    if (ar.ok) {
                        const arr = await ar.arrayBuffer();
                        if (arr.byteLength > 1000) {
                            audioBuffer = Buffer.from(arr);
                            const dlType = ar.headers.get('content-type') || '';
                            audioExt = /mp4|m4a/i.test(dlType) || /\.(m4a|mp4)(\?|$)/i.test(audioUrl) ? 'm4a' : 'mp3';
                            usedSource = api.name;
                            break;
                        }
                    } else {
                        lastError = `${api.name}: audio HTTP ${ar.status}`;
                    }
                }
            } catch (e) { lastError = `${api.name}: ${e.message?.substring(0, 50) || 'timeout'}`; }
            if (audioBuffer) break;
        }
    }

    if (!audioBuffer) {
        const combinedError = primaryYtDlpError
            ? `${primaryYtDlpError}${lastError && lastError !== primaryYtDlpError ? ` | API fallback: ${lastError}` : ''}`
            : (lastError || 'All sources failed');
        let hint = '';
        if (!await resolveYtDlpBinary()) {
            hint += '\n\nLocal yt-dlp install failed. Server ko GitHub access aur ./store write permission chahiye.';
        } else if (!fs.existsSync(FFMPEG_BIN) && !await commandAvailable('ffmpeg')) {
            hint += '\n\nMP3 conversion ke liye ffmpeg install karo; bot M4A fallback automatically try karta hai.';
        }
        if (/sign in to confirm|not a bot|cookies/i.test(combinedError) && !ensureYoutubeCookies()) {
            hint += '\n\nYouTube verification ke liye Netscape cookies file `./data/youtube_cookies.txt` upload karo aur bot restart karo.';
        }
        return { success: false, error: combinedError + hint, buffer: null, source: null };
    }

    // Send audio
    try {
        await sock.sendMessage(jid, {
            audio: audioBuffer,
            mimetype: audioExt === 'm4a' || audioExt === 'mp4' ? 'audio/mp4' : 'audio/mpeg',
            fileName: `${styleText(videoMeta?.title?.substring(0, 40) || 'audio')}.${audioExt}`, 
            contextInfo: {
                externalAdReply: {
                    title: styleText(videoMeta?.title?.substring(0, 100) || "DENJI X"),
                    body: ` ${styleText(videoMeta?.author?.name || "Unknown")} • ${usedSource}`,
                    thumbnailUrl: videoMeta?.thumbnail || '',
                    mediaType: 1,
                    renderLargerThumbnail: true
                }
            }
        }, quoted ? {quoted} : {});
        return { success: true, error: null, buffer: audioBuffer, source: usedSource };
    } catch (e) {
        return { success: false, error: e.message, buffer: audioBuffer, source: usedSource };
    }
}


// ==================== 🤖 AI API HELPER (Addy ChatGPT, Free, No Key) ====================
// Primary: Addy ChatGPT (addy-chatgpt-api.vercel.app) — Hinglish friendly
// Returns: {success, reply} JSON

async function aiGenerate(prompt, options = {}) {
    const timeout = Math.max(5000, Number(options.timeout) || 30000);
    const maxTokens = Math.max(50, Math.min(1500, Number(options.maxTokens) || 400));
    const systemPrompt = options.systemPrompt || 'Reply helpfully and concisely in Hinglish.';
    const messages = [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: String(prompt).slice(0, 8000) }
    ];
    const errors = [];

    // 1) User-configured OpenAI-compatible provider (most reliable option).
    if (process.env.OPENAI_API_KEY) {
        try {
            const base = (process.env.OPENAI_BASE_URL || 'https://api.openai.com/v1').replace(/\/$/, '');
            const response = await fetch(`${base}/chat/completions`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`
                },
                body: JSON.stringify({
                    model: process.env.OPENAI_MODEL || 'gpt-4o-mini',
                    messages, max_tokens: maxTokens, temperature: 0.8
                }),
                signal: AbortSignal.timeout(timeout)
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            const text = data.choices?.[0]?.message?.content?.trim();
            if (text) return { success: true, text, source: 'openai-compatible' };
            throw new Error('empty response');
        } catch (e) { errors.push(`OpenAI: ${e.message}`); }
    }

    // 2) Gemini when GEMINI_API_KEY is configured.
    if (process.env.GEMINI_API_KEY) {
        try {
            const model = process.env.GEMINI_MODEL || 'gemini-2.0-flash';
            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${process.env.GEMINI_API_KEY}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    systemInstruction: { parts: [{ text: systemPrompt }] },
                    contents: [{ role: 'user', parts: [{ text: String(prompt).slice(0, 8000) }] }],
                    generationConfig: { maxOutputTokens: maxTokens, temperature: 0.8 }
                }),
                signal: AbortSignal.timeout(timeout)
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            const text = data.candidates?.[0]?.content?.parts?.map(part => part.text || '').join('').trim();
            if (text) return { success: true, text, source: 'gemini' };
            throw new Error('empty response');
        } catch (e) { errors.push(`Gemini: ${e.message}`); }
    }

    // 3) Free fallbacks; these may occasionally be rate-limited.
    try {
        const combined = `${systemPrompt}\n\nUser: ${String(prompt).slice(0, 5000)}`;
        const response = await fetch(`https://text.pollinations.ai/${encodeURIComponent(combined)}?model=openai`, {
