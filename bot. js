                        'Roast Img: ' + (imgOk ? '✅ ' + (fs.statSync(img).size / 1024).toFixed(1) + ' KB' : '❌ not set (.rimg)'),
                        'Roast Aud: ' + (audOk ? '✅ ' + (fs.statSync(aud).size / 1024).toFixed(1) + ' KB' : '❌ not set (.raudio)'),
                        'Domain GIF/Vid: ' + (dvidOk ? '✅ ' + (fs.statSync(dvid).size / 1024 / 1024).toFixed(2) + ' MB (' + getMediaType(this.tenantId, 'domain') + ')' : '❌ not set (.dvid)'),
                        'Text pack: ' + fancyNumber(ROAST_TEXT_TEMPLATES.length) + ' lines',
