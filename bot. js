                    if (subRmvRoles.subAdmins.length !== beforeSubRmv) {
                        await this.sendMessage(chatId, this.card('Sub-Admin Removed', [
                            '🗑️ ' + describeJid(subRmvCandidates[0]),
                            '🔰 Remaining sub-admins: ' + subRmvRoles.subAdmins.length
