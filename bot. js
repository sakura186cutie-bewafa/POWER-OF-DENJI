                    if (pinText.length > 3000) return await this.send(from, '⟪ ⚠️ PSPAM text maximum 3000 characters hai. ⟫');
                    if (this.globalLock) this.globalLock = false;
                    const pspamKey = `${from}_pspam`;
                    if (this.activeTasks.has(pspamKey)) {
                        return await this.send(from, `⟪ ⚠️ PSPAM already active. Stop: ${getTenantPrefix(this.tenantId)}stoppspam ⟫`);
