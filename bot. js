                case 'arisevid': case 'ariseimg': case 'raidvid': case 'raidimg': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const irv = command === 'arisevid' || command === 'raidvid';
                    const irm = irv ? (quotedMsg?.quotedMessage?.videoMessage || msg.message?.videoMessage) : (quotedMsg?.quotedMessage?.imageMessage || msg.message?.imageMessage);
                    if (!irm) return await this.send(from, `⟪ ⚠️ Reply to a ${irv ? 'video' : 'image'}! ⟫`);
                    try {
