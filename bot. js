function lifecycleCard(kind, original, loops = 0, context = {}) {
    if (typeof original !== 'string' || original.includes('𝐕ᴇʀꜱɪᴏɴ:- 𝟐𝟕')) return original;
    const stop = kind === 'stop';
    const command = normalizeCommandName(context.command || (stop ? 'stop' : 'process'));
    const displayCommand = styleText(command.charAt(0).toUpperCase() + command.slice(1).toLowerCase());
    const fleet = Math.max(1, Number(context.fleet) || 1);
    const parallel = Math.max(1, Number(context.threads) || 1);
    const delayMs = Math.max(0, Number(context.delay) || 0);
    const burst = fleet * parallel;
    const input = fancyNumber(String(context.input || '').trim().slice(0, 500));
    const stopAliasMap = { fstn: 'stopfastnc', fastnc: 'stopfastnc', ud: 'stopdesc' };
    const stopCommand = command.startsWith('stop') ? command : (stopAliasMap[command] || `stop${command}`);

    if (!stop) {
        const lines = [];
        if (context.targetLabel) lines.push('🎯 Target: ' + context.targetLabel);
        lines.push('🤖 Fleet: ' + fancyNumber(fleet) + ' bots — Main + Child');
        lines.push('⚡ Burst: ' + fancyNumber(burst) + '  •  Parallel: ' + fancyNumber(parallel));
        if (delayMs > 0) lines.push('🕒 Delay: ' + fancyNumber(delayMs) + ' ms');
        if (input) lines.push('📝 Text: ' + coreStyleText(input));
        lines.push('');
        lines.push('🛑 Stop: .' + stopCommand);
        return DEV_CARD(displayCommand + ' — Started', lines);
    }

    const category = context.stopCategory || getStopCategory(command);
    const lines = [
        '• Command: ' + displayCommand,
        '• Active Loops Stopped: ' + fancyNumber(Math.max(0, Number(loops) || 0)),
        ''
    ];
    for (const l of stopCategoryLines(category)) lines.push(l);
    return DEV_CARD('🛑 System Purge Complete', lines);
}
