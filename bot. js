// Swaps the DEV wordmark (𝐃⃝𝛆֟፝𝛎) for a custom owner name in bold-math
// font (𝐇𝐞𝐥𝐥𝐨 style) - applied to the menu header + every card logo.
// Persisted in ./data/brand.json so it survives restarts.
// Wordmark always sits between the ꨄ keeper and the closing 』 bracket in
// every brand constant, so the swap is fully deterministic (also tolerates the
// ZWSP variant used inside the card-logo glyph):
function devBrandApplyName(text, styledName) {
    const k = String(text).indexOf('ꨄ');
    const e = String(text).indexOf('』', k + 1);
    if (k < 0 || e < 0) return String(text);
    return text.slice(0, k + 1) + styledName + text.slice(e);
}
function devStyleBoldName(value) {
    return String(value ?? '').replace(/[A-Za-z0-9]/g, ch => {
        const c = ch.charCodeAt(0);
        if (c >= 65 && c <= 90) return String.fromCodePoint(0x1D400 + (c - 65));
        if (c >= 97 && c <= 122) return String.fromCodePoint(0x1D41A + (c - 97));
        return String.fromCodePoint(0x1D7CE + (c - 48));
    });
}
