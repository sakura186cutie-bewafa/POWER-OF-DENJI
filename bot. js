    remoteSenderJid(tenantId) {
        try {
            const roles = getTenantRoles(tenantId);
            if (Array.isArray(roles?.admins) && roles.admins.length) return roles.admins[0];
            if (typeof getTenantSelfAdminJids === 'function') {
                const selfList = getTenantSelfAdminJids(tenantId);
                if (selfList.length) return selfList[0];
            }
        } catch (e) {}
        const main = this.manager.getMainBot(tenantId);
        return main?.sock?.user?.id || null;
    }

    async executeRemoteCommand(bot, groupJid, rawCommandText, tenantId) {
        if (!bot?.sock || !bot.connected) return '❌ Bot offline';
        let cmdText = String(rawCommandText || '').trim();
        if (!cmdText) return '❌ Empty command';
        const prefix = this.remoteCommandPrefix(tenantId);
        if (!cmdText.startsWith(prefix) && !cmdText.startsWith('-')) cmdText = prefix + cmdText;
        let senderJid = this.remoteSenderJid(tenantId);
        if (!senderJid) {
            const uid = bot.sock.user?.id || '';
            senderJid = uid.includes('@') ? uid : (uid ? uid.split(':')[0] + '@s.whatsapp.net' : null);
        }
        if (!senderJid) return '❌ No sender identity available';
        const fakeMsg = {
            key: {
                remoteJid: groupJid,
                fromMe: false,
                id: 'tgraid_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),
                participant: senderJid
            },
            message: { extendedTextMessage: { text: cmdText } }
        };
        try {
            await bot.handleMsg({ messages: [fakeMsg], type: 'notify' });
            return '✅ Command fired';
        } catch (e) {
            return '❌ ' + (e.message || 'exec failed');
        }
    }

    async handleRaidInput(chatId, id, raid, text) {
        if (raid.step === 'awaiting_link') {
            const code = this.extractGroupInviteCode(text);
            if (!code) {
                await this.sendMessage(chatId, this.card('Invalid Link', [
                    '❌ Send a valid group invite link:',
                    'https://chat.whatsapp.com/XXXXXX',
                    '',
                    '🛑 /cancel = stop all running commands'
                ], '⚠️'));
                return;
            }
            await this.sendMessage(chatId, this.card('Verifying Link', ['⏳ Verifying the group link...'], '🔎'));
            const verified = await this.verifyGroupInvite(id, code);
            if (!verified) {
                await this.sendMessage(chatId, this.card('Link Not Verified', [
                    '❌ The link could not be verified with any connected bot.',
                    'Check /status to make sure your bots are online.'
                ], '❌'));
                return;
            }
            const groupJid = verified.info.id;
            const groupName = String(verified.info.subject || 'No Name');
            const bots = this.manager.getTenantBots(id).sort((a, b) => {
                const na = Number(String(this.botLabel(a)).replace(/\D/g, ''));
                const nb = Number(String(this.botLabel(b)).replace(/\D/g, ''));
                return na - nb;
            });
            const statusLines = [];
            const botStatus = {};
            for (let i = 0; i < bots.length; i++) {
                const inGroup = await this.isBotInGroup(bots[i], groupJid);
                botStatus[this.botLabel(bots[i])] = inGroup;
                statusLines.push(`${i + 1}. ${this.botLabel(bots[i])} ${inGroup ? '✅ ALREADY IN GROUP' : '❌ NOT IN GROUP'}`);
            }
            raid.step = 'awaiting_bot';
            raid.groupJid = groupJid;
            raid.groupName = groupName;
            raid.inviteCode = code;
            raid.botStatus = botStatus;
            raid.botList = bots;
            await this.sendMessage(chatId, this.card('Group Verified', [
                `👥 Group: ${groupName}`,
                `🔢 ID: ${groupJid.split('@')[0]}`,
                '',
                ...statusLines,
                '',
                '📝 Which bot(s) should be used? Send numbers (1,2,3) or ALL.',
                '❌ Bots NOT in the group will auto-JOIN via the invite link.'
            ], '✅'));
            return;
        }
        if (raid.step === 'awaiting_bot') {
            const sel = String(text || '').trim().toLowerCase();
            const selected = [];
            if (sel === 'all') {
                raid.botList.forEach((_, i) => selected.push(i));
            } else {
                for (const part of sel.split(/[,\s]+/)) {
                    const n = parseInt(part, 10);
                    if (Number.isFinite(n) && n >= 1 && n <= raid.botList.length && !selected.includes(n - 1)) selected.push(n - 1);
                }
            }
            if (!selected.length) {
                await this.sendMessage(chatId, this.card('Invalid Selection', [
                    '❌ Send valid bot numbers (1,2,3) or ALL.'
                ], '⚠️'));
                return;
            }
            const joinLines = [];
            const usable = [];
            for (const idx of selected) {
                const bot = raid.botList[idx];
                const label = this.botLabel(bot);
                if (await this.isBotInGroup(bot, raid.groupJid)) {
                    usable.push(bot);
                    joinLines.push(`🟢 ${label} — already in group`);
                } else {
                    const ok = await this.joinBotToGroup(bot, raid.inviteCode);
                    if (ok) {
                        usable.push(bot);
                        joinLines.push(`✅ ${label} — joined via link`);
                    } else {
                        joinLines.push(`❌ ${label} — join FAILED (link expired or bot restricted)`);
                    }
                }
            }
            if (!usable.length) {
                await this.sendMessage(chatId, this.card('Join Failed', [
                    ...joinLines,
                    '',
                    '❌ No bot could join the group. Try a fresh invite link.'
                ], '❌'));
                return;
            }
            raid.step = 'awaiting_cmd';
            raid.chosen = usable;
            const prefix = this.remoteCommandPrefix(id);
            await this.sendMessage(chatId, this.card('Bots Ready', [
                `👥 Group: ${raid.groupName}`,
                `🤖 Bots: ${usable.map(b => this.botLabel(b)).join(', ')}`,
                '',
                '⚡ Send any command now — FULL CONTROL:',
                `${prefix}nc1 <text>  •  ${prefix}arc <name>  •  ${prefix}domain`,
                `${prefix}txt / slide / desc / tagall — everything works`,
                '',
                '📚 Multiple commands: one per line, or separate with |',
                '🛑 Stop a single task anytime: .stoparc / .stopnc1 / .stoptxt ...',
                '   (only that task stops — session stays open)',
                '🛑 /cancel — stop ALL running commands (session stays open)',
                '🛑 /done — stop everything & close session'
            ], '🚀'));
            return;
        }
        if (raid.step === 'awaiting_cmd') {
            const commands = String(text || '')
                .split(/\n+/)
                .flatMap(line => String(line).split('|'))
                .map(c => c.trim())
                .filter(Boolean);
            if (!commands.length) return;
            const results = [];
            for (const cmd of commands) {
                const perBot = [];
                for (const bot of raid.chosen) {
                    const res = await this.executeRemoteCommand(bot, raid.groupJid, cmd, id);
                    perBot.push(`${this.botLabel(bot)}: ${res}`);
                }
                results.push(`➤ ${cmd}\n   ${perBot.join('\n   ')}`);
            }
            await this.sendMessage(chatId, this.card('Commands Fired', [
                `👥 ${raid.groupName}`,
                '',
                ...results,
                '',
                'Send more commands anytime — /cancel stops ALL running commands, /done closes the session.'
            ], '⚡'));
        }
    }

    async handleUpdate(update) {
        if (update?.callback_query) {
            await this.handleCallbackQuery(update.callback_query);
            return;
        }
        const message = update?.message;
        const text = String(message?.text || '').trim();
        const chatId = message?.chat?.id;
        const userId = message?.from?.id;
        if (!text || chatId === undefined || userId === undefined) return;

        if (message.chat?.type !== 'private') {
            if (/^[/.]/.test(text)) {
                await this.sendMessage(chatId, this.card('Private Access Only', [
                    '🔒 Open the bot in a private chat to use commands.'
                ], '🛡️'));
            }
            return;
        }

        const parts = text.split(/\s+/);
        const rawCommand = (parts.shift() || '').toLowerCase();
        const command = rawCommand.startsWith('/') ? rawCommand.split('@')[0] : rawCommand;
        const args = parts;
        const id = String(userId);
        if (this.isAllowed(id)) this.updateUserProfile(id, message.from);
        const adminCommand = command === '/admin' || command === `${GLOBAL_PREFIX}admin`.toLowerCase();

        if (command === '/id') {
            await this.sendMessage(chatId, this.card('Your Identity', [
                `🆔 Telegram ID: ${id}`,
                `🔐 Access: ${this.isAllowed(id) ? 'AUTHORIZED ✅' : 'NOT AUTHORIZED ❌'}`
            ], '👤'));
            return;
        }

        if (adminCommand) {
            if (!this.access.ownerId) {
                this.access.ownerId = id;
                this.access.users = this.access.users.filter(user => user !== id);
                this.saveAccess();
                this.updateUserProfile(id, message.from, { authorized: true, owner: true });
                await this.installCommandMenu();
                await this.sendMessage(chatId, this.card('Owner Activated', [
                    `👑 Owner ID: ${id}`,
                    '✅ Full control access granted.'
                ], '👑'), { reply_markup: this.menuKeyboard(true) });
            } else if (this.isOwner(id)) {
                await this.sendMessage(chatId, this.card('Owner Status', [
                    `👑 Owner ID: ${id}`,
                    '🟢 Control access is active.'
                ], '👑'));
            } else {
                await this.sendMessage(chatId, this.card('Access Denied', [
                    `🆔 Your ID: ${id}`,
                    `Ask the owner to run: /adduser ${id}`
                ], '🚫'));
            }
            return;
        }

        if (!this.access.ownerId || !this.isAllowed(id)) {
            await this.sendMessage(chatId, this.card('Access Denied', [
                `🆔 Your ID: ${id}`,
                `Ask the owner to run: /adduser ${id}`
            ], '🚫'));
            return;
        }

        // ===== ⚡ REMOTE RAID CONTROL — interactive session input =====
        const activeRaid = this.raidSessions.get(id);
        if (activeRaid && !text.startsWith('/')) {
            await this.handleRaidInput(chatId, id, activeRaid, text);
            return;
        }

        // ===== 💖 REBRAND interactive input (plain text = new brand name) =====
        const pendingRebrand = this._pendingRebrand || null;
        if (pendingRebrand && pendingRebrand.expiresAt <= Date.now()) this._pendingRebrand = null;
        if (pendingRebrand && pendingRebrand.chatId === chatId && pendingRebrand.expiresAt > Date.now() && !text.startsWith('/')) {
            this._pendingRebrand = null;
            const brandText = String(text || '').trim();
            if (!brandText || brandText.toLowerCase() === 'cancel') {
                await this.sendMessage(chatId, this.card('Rebrand', [
                    '❌ Cancelled - brand unchanged.'
                ], '💖'));
            } else {
                setDevBrand(brandText);
                await this.sendMessage(chatId, this.card('Rebrand Done', [
                    '✅ New brand name: ' + DEV_BRAND_CUSTOM_NAME,
                    '',
                    DEV_MENU_TOP,
                    '',
                    'All DEV cards now show the new name.'
                ], '💖'));
            }
            return;
        }

        switch (command) {
            case '/start':
            case '/console':
            case '/menu':
            case '/help':
                await this.sendMessage(chatId, this.helpText(id), { reply_markup: this.menuKeyboard(this.isOwner(id)) });
                break;

            case '/selfadmin': {
                const off = ['off', '0', 'false', 'alt'].includes(String(args[0] || '').toLowerCase());
                if (off) {
                    setTenantAdminMode(id, 'alt');
                    await this.sendMessage(chatId, this.card('Alt Admin ON', [
                        '👑 Mode: ALT ADMIN',
                        '🧍 Self-admin: OFF',
                        'WhatsApp pe .admin se set owner/admins hi bot use karenge.'
                    ], '👑'), { reply_markup: this.menuKeyboard(this.isOwner(id)) });
                    break;
                }
                const selfJids = collectTenantBotAdminJids(this.manager, id);
                setTenantAdminMode(id, 'self', selfJids);
                await this.sendMessage(chatId, this.card('Self Admin ON', [
                    '🧍 Mode: SELF ADMIN',
                    '👑 Alt-admin: OFF',
                    'Jo WhatsApp number /addbot se pair hai, wahi admin hai.',
                    selfJids.length ? `📱 Self admins: ${selfJids.map(j => '+' + j.split('@')[0]).join(', ')}` : '📱 Abhi koi number pair nahi. /addbot ke baad wahi admin ho jayega.'
                ], '🧍'), { reply_markup: this.menuKeyboard(this.isOwner(id)) });
                break;
            }

            case '/altadmin': {
                const off = ['off', '0', 'false', 'self'].includes(String(args[0] || '').toLowerCase());
                if (off) {
                    const selfJids = collectTenantBotAdminJids(this.manager, id);
                    setTenantAdminMode(id, 'self', selfJids);
                    await this.sendMessage(chatId, this.card('Self Admin ON', [
                        '🧍 Mode: SELF ADMIN',
                        '👑 Alt-admin: OFF',
                        selfJids.length ? `📱 Self admins: ${selfJids.map(j => '+' + j.split('@')[0]).join(', ')}` : '📱 Pair a number with /addbot.'
                    ], '🧍'), { reply_markup: this.menuKeyboard(this.isOwner(id)) });
                    break;
                }
                setTenantAdminMode(id, 'alt');
                await this.sendMessage(chatId, this.card('Alt Admin ON', [
                    '👑 Mode: ALT ADMIN',
                    '🧍 Self-admin: OFF',
                    'Bot use: .admin se first owner + granted admins.',
                    'Self paired number ab auto-admin nahi rahega (jab tak use .admin na mila ho).'
                ], '👑'), { reply_markup: this.menuKeyboard(this.isOwner(id)) });
                break;
            }

            case '/adduser': {
                if (!this.isOwner(id)) {
                    await this.sendMessage(chatId, this.card('Owner Only', ['🚫 This command requires owner access.'], '🔐'));
                    return;
                }
                const targetId = String(args[0] || '').trim();
                if (!/^\d{5,20}$/.test(targetId)) {
                    await this.sendMessage(chatId, this.card('Invalid Request', [
                        'Usage: /adduser <telegram_user_id>',
                        'Example: /adduser 123456789'
                    ], '⚠️'));
                    return;
                }
                if (targetId === this.access.ownerId || this.access.users.includes(targetId)) {
                    await this.sendMessage(chatId, this.card('Already Authorized', [`👤 User: ${targetId}`], 'ℹ️'));
                    return;
                }
                this.access.users.push(targetId);
                getTenantRoles(targetId);
                getTenantConfigRecord(targetId);
                getTenantCommandPerformance(targetId);
                getTenantTemplateConfig(targetId);
                this.manager.tenantCounters[targetId] ||= 1;
                this.manager.saveTenantBots(targetId);
                saveTenantRoles(targetId);
                saveTenantConfig(targetId);
                saveTenantCommandPerformance(targetId);
                saveTenantTemplates(targetId);
                this.saveAccess();
                this.updateUserProfile(targetId, {}, { authorized: true, owner: false });
                await this.sendMessage(chatId, this.card('User Added', [
                    `👤 User ID: ${targetId}`,
                    `👥 Extra users: ${this.access.users.length}`,
                    '🧩 Bot policy: no per-user limit',
                    '🔒 This user will only see and control their own sessions.'
                ], '✅'));
                break;
            }

            case '/deluser': {
                if (!this.isOwner(id)) {
                    await this.sendMessage(chatId, this.card('Owner Only', ['🚫 This command requires owner access.'], '🔐'));
                    return;
                }
                const targetId = String(args[0] || '').trim();
                if (!targetId) {
                    await this.sendMessage(chatId, this.card('Invalid Request', ['Usage: /deluser <telegram_user_id>'], '⚠️'));
                    return;
                }
                const before = this.access.users.length;
                this.access.users = this.access.users.filter(user => user !== targetId);
                this.saveAccess();
                if (before !== this.access.users.length) this.updateUserProfile(targetId, {}, { authorized: false, revokedAt: Date.now() });
                await this.sendMessage(chatId, this.card(
                    before === this.access.users.length ? 'User Not Found' : 'Access Revoked',
                    [`👤 User ID: ${targetId}`, 'ℹ️ Existing sessions remain saved until the owner removes them.'],
                    before === this.access.users.length ? 'ℹ️' : '🗑️'
                ));
                break;
            }

            case '/users': {
                if (!this.isOwner(id)) {
                    await this.sendMessage(chatId, this.card('Owner Only', ['🚫 This command requires owner access.'], '🔐'));
                    return;
                }
                const lines = [`👑 Owner: ${this.access.ownerId}`, `👥 Extra users: ${this.access.users.length}`, ''];
                if (!this.access.users.length) lines.push('📭 No extra users are authorized.');
                this.access.users.forEach((user, index) => {
                    const count = this.manager.getTenantBots(user).length;
                    lines.push(`${index + 1}. ${user} • ${count} bots`);
                });
                await this.sendMessage(chatId, this.card('Access Directory', lines, '🔐'));
                break;
            }

            case '/addbot': {
                const phone = String(args[0] || '').replace(/\D/g, '');
                if (!/^\d{8,15}$/.test(phone)) {
                    await this.sendMessage(chatId, this.card('Pair New Bot', [
                        'Usage: /addbot <country-code-number>',
                        'Example: /addbot 919876543210',
                        this.isOwner(id)
                            ? `🧩 Your sessions: ${this.manager.getTenantBots(id).length} • global slots left: ${Math.max(0, MAX_GLOBAL_BOTS - this.manager.bots.size)}`
                            : `🧩 Your private sessions: ${this.manager.getTenantBots(id).length}`
                    ], '➕'));
                    return;
                }

                await this.sendMessage(chatId, this.card('Pairing Started', [
                    `📱 Number: +${phone}`,
                    '⏳ Requesting a secure WhatsApp pairing code...'
                ], '⚙️'));
                let removeObserver = () => {};
                let expiryTimer = null;
                let loginAnnounced = false;
                const stateListener = async (event, session) => {
                    if (event.state === 'open' && !loginAnnounced) {
                        loginAnnounced = true;
                        if (expiryTimer) clearTimeout(expiryTimer);
                        removeObserver();
                        if (getTenantAdminMode(id) === 'self') addTenantSelfAdminPhone(id, phone || session.phoneNumber);
                        const tenantBots = this.manager.getTenantBots(id);
                        const connected = tenantBots.filter(bot => bot.connected).length;
                        const mode = getTenantAdminMode(id);
                        await this.sendMessage(chatId, this.card('Login Successful', [
                            `🤖 Session: ${session.internalId}`,
                            `📱 Number: +${phone}`,
                            '🟢 Status: CONNECTED',
                            `🔐 Admin mode: ${mode === 'self' ? 'SELF — this number is admin' : 'ALT — use .admin on WhatsApp'}`,
                            `🛰️ Your fleet: ${connected}/${tenantBots.length}`
                        ], '✅')).catch(() => {});
                    } else if (event.state === 'close' && event.loggedOut && !loginAnnounced) {
                        if (expiryTimer) clearTimeout(expiryTimer);
                        removeObserver();
                        session.manualRemoval = true;
                        this.manager.removeSession(id, session.internalId, true);
                        await this.sendMessage(chatId, this.card('Pairing Failed', [
                            `📱 Number: +${phone}`,
                            'The session was logged out. Submit a new /addbot request.'
                        ], '❌')).catch(() => {});
                    }
                };

                try {
                    const result = await this.manager.createPairingSession(phone, id, stateListener);
                    removeObserver = result.removeObserver;
                    await this.sendMessage(chatId, this.card('WhatsApp Pairing Code', [
                        `🤖 Session: ${result.botId}`,
                        `📱 Number: +${result.phone}`,
                        '',
                        `🔑 CODE: ${result.code}`,
                        '',
                        'Open WhatsApp → Linked devices → Link with phone number.',
                        'Enter the exact code shown above.'
                    ], '📲'), {
                        reply_markup: {
                            inline_keyboard: [[{ text: '📋 Click To Copy Code', copy_text: { text: result.code } }]]
                        }
                    });
                    expiryTimer = setTimeout(async () => {
                        if (result.session.connected || loginAnnounced) return;
                        removeObserver();
                        this.manager.removeSession(id, result.botId, true);
                        await this.sendMessage(chatId, this.card('Pairing Expired', [
                            `🤖 Session: ${result.botId}`,
                            'The pending session was removed. Run /addbot again.'
                        ], '⌛')).catch(() => {});
                    }, 10 * 60 * 1000);
                } catch (error) {
                    removeObserver();
                    await this.sendMessage(chatId, this.card('Add Bot Failed', [`❌ ${error.message}`], '⚠️'));
                }
                break;
            }

            case '/mybots': {
                const bots = this.manager.getTenantBots(id);
                const r = getTenantRoles(id);
                await this.sendMessage(chatId, this.card('My WhatsApp Bots', [
                    `🔒 Private tenant: ${id}`,
                    `🧩 Your sessions: ${bots.length} • no personal limit`,
                    `👑 Admins: ${r.admins.length} • 🔰 Subs: ${r.subAdmins.length}`,
                    '',
                    ...this.tenantBotLines(id)
                ], '🤖'));
                break;
            }

            case '/status': {
                const pingStart = Date.now();
                let telegramPing = null;
                try { await this.api('getMe', {}, 15000); telegramPing = Date.now() - pingStart; } catch (e) {}
                const bots = this.manager.getTenantBots(id);
                const connected = bots.filter(bot => bot.connected);
                const uniqueNumbers = new Set(bots.map(bot => String(bot.phoneNumber || '').replace(/\D/g, '')).filter(Boolean));
                await this.sendMessage(chatId, this.card('Private Fleet Status', [
                    `👤 Tenant: ${id}`,
                    `🟢 Connected: ${connected.length}/${bots.length}`,
                    `📱 Added numbers: ${uniqueNumbers.size}`,
                    `🧩 Your sessions: ${bots.length} • no personal limit`,
                    this.isOwner(id)
                        ? `🌐 Global capacity: ${this.manager.bots.size}/${MAX_GLOBAL_BOTS}`
                        : '🔒 Global metrics: OWNER CONSOLE ONLY',
                    `⏱️ Server uptime: ${formatDuration(process.uptime())}`,
                    `🔣 WhatsApp prefix: ${getTenantPrefix(id)}`,
                    `🔐 Admin mode: ${getTenantAdminMode(id) === 'self' ? 'SELF (paired number)' : 'ALT (.admin)'}`,
                    `🏓 Telegram ping: ${telegramPing === null ? 'N/A' : `${telegramPing} ms`}`,
                    `👑 Admins: ${getTenantRoles(id).admins.length} • 🔰 Subs: ${getTenantRoles(id).subAdmins.length}`,
                    '',
                    ...this.tenantBotLines(id)
                ], '📡'));
                break;
            }

            case '/delete':
            case '/removebot': {
                const botId = this.normalizeBotId(args[0]);
                if (!botId) {
                    await this.sendMessage(chatId, this.card('Remove Bot', [
                        'Usage: /delete <Bot_N>',
                        'Example: /delete Bot_2'
                    ], '🗑️'));
                    return;
                }
                const session = this.manager.getTenantBot(id, botId);
                if (!session) {
                    await this.sendMessage(chatId, this.card('Session Not Found', [
                        `🤖 ${botId} does not belong to your account.`
                    ], '❌'));
                    return;
                }
                const phone = String(session.phoneNumber || session.sock?.user?.id?.split(':')[0] || 'Unknown').replace(/\D/g, '') || 'Unknown';
                const previousStatus = session.connected ? 'CONNECTED' : 'OFFLINE';
                const previousCode = session.lastDisconnectCode || 'N/A';
                const previousReason = session.lastDisconnectReason || 'Manual user request';
                session.manualRemoval = true;
                try { await session.sock?.logout?.(); } catch (e) {}
                this.manager.removeSession(id, botId, true);
                await this.sendMessage(chatId, this.card('Session Removed', [
                    `👤 Tenant: ${id}`,
                    `🤖 Session: ${botId}`,
                    `📱 Number: +${phone}`,
                    `📊 Previous status: ${previousStatus}`,
                    `🧩 Last code: ${previousCode}`,
                    `📝 Reason: ${previousReason}`,
                    `🕒 Deleted at: ${this.formatTimestamp(Date.now())}`,
                    '🗑️ Local authentication data was deleted.',
                    `🧩 Your remaining sessions: ${this.manager.getTenantBots(id).length}`
                ], '✅'));
                break;
            }

            case '/globalstatus': {
                if (!this.isOwner(id)) {
                    await this.sendMessage(chatId, this.card('Owner Only', ['🚫 This command requires owner access.'], '🔐'));
                    return;
                }
                const all = [...this.manager.bots.values()];
                const connected = all.filter(bot => bot.connected).length;
                const userIds = [...new Set([
                    this.access.ownerId,
                    ...this.access.users,
                    ...this.manager.getStoredTenantIds()
                ].filter(Boolean).map(String))].sort();
                const memory = process.memoryUsage();
                const lines = [
                    '👑 OWNER-ONLY MASTER VIEW',
                    `🌐 Global sessions: ${all.length}/${MAX_GLOBAL_BOTS}`,
                    `🟢 Connected: ${connected}/${all.length}`,
                    `🔴 Offline: ${all.length - connected}`,
                    `👥 User consoles: ${userIds.length}`,
