                case 'setarise': case 'setraid': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const ariseMedia = findMediaMessage(msg, quotedMsg, 'video') || findMediaMessage(msg, quotedMsg, 'image');
                    if (!ariseMedia) return await this.send(from, '⟪ ⚠️ Video/Image ko reply karke `.setarise` bhejo. ⟫');
                    try {
                        await this.send(from, '⚙️ Arise media download ho rahi hai...');
                        const ariseIsVid = !!findMediaMessage(msg, quotedMsg, 'video');
                        const buffer = await downloadMediaBuffer(ariseMedia, ariseIsVid ? 'video' : 'image', 50 * 1024 * 1024);
                        this.pendingMediaChoice = { from, senderKey: normalizedSender, type: 'setarise', buffer, isVideo: ariseIsVid };
                        await this.send(from, DEV_CARD('Arise Media Type', [
                            '✅ Media download ho gaya!',
                            '',
                            '1️⃣ Video (🎵 audio ke saath)',
                            '2️⃣ Animation (🎞️ GIF)',
                            '',
                            'Reply karein `1` ya `2`'
                        ]));
                    } catch (e) {
                        await this.send(from, `❌ *SETARISE FAILED*\n${e.message}`);
                    }
                    break;
                }
                
                case 'setoff': case 'setsleep': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const offMedia = findMediaMessage(msg, quotedMsg, 'video') || findMediaMessage(msg, quotedMsg, 'image');
                    if (!offMedia) return await this.send(from, '⟪ ⚠️ Video/Image ko reply karke `.setoff` bhejo. ⟫');
                    try {
                        await this.send(from, '⚙️ Sleep media download ho rahi hai...');
                        const offIsVid = !!findMediaMessage(msg, quotedMsg, 'video');
                        const buffer = await downloadMediaBuffer(offMedia, offIsVid ? 'video' : 'image', 50 * 1024 * 1024);
                        this.pendingMediaChoice = { from, senderKey: normalizedSender, type: 'setoff', buffer, isVideo: offIsVid };
                        await this.send(from, DEV_CARD('Sleep Media Type', [
                            '✅ Media download ho gaya!',
                            '',
                            '1️⃣ Video (🎵 audio ke saath)',
                            '2️⃣ Animation (🎞️ GIF)',
                            '',
                            'Reply karein `1` ya `2`'
                        ]));
                    } catch (e) {
                        await this.send(from, `❌ *SETOFF FAILED*\n${e.message}`);
                    }
                    break;
                }

                case 'rmimg': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const p = tenantAssetPath(this.tenantId, 'menu_image.jpg');
                    if (fs.existsSync(p)) { fs.unlinkSync(p); await this.send(from, "🗑️ Menu image removed."); }
                    else await this.send(from, "⚠️ No menu image found.");
                    break;
                }

                case 'rmvid': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const p = tenantAssetPath(this.tenantId, 'menu_video.mp4');
                    if (fs.existsSync(p)) { fs.unlinkSync(p); await this.send(from, "🗑️ Menu video removed."); }
                    else await this.send(from, "⚠️ No menu video found.");
                    break;
                }

                case 'wipe': {
                    this.hsee.clearAll();
                    this.messageProcessingQueue = [];
                    this.activeProcessing = 0;
                    this.hsee.clearCache();
                    this.incomingSpamGuard.clear();
                    this.store.messages.clear();
                    if (typeof global.gc === 'function') global.gc();
                    const ru = (process.memoryUsage().heapUsed / 1024 / 1024).toFixed(2);
                    const rt = (process.memoryUsage().heapTotal / 1024 / 1024).toFixed(2);
                    await this.send(from, `⟪ 🧹 𝐒𝐔𝐏𝐄𝐑-𝐖𝐈𝐏𝐄 ⟫\n💾 RAM: ${ru}MB / ${rt}MB`);
                    break;
                }

                case 'clear': {
                    this.hsee.clearCache();
                    this.store.messages.clear();
                    this.incomingSpamGuard.clear();
                    if (typeof global.gc === 'function') global.gc();
                    const ru = (process.memoryUsage().heapUsed / 1024 / 1024).toFixed(2);
                    const rt = (process.memoryUsage().heapTotal / 1024 / 1024).toFixed(2);
                    await this.send(from, `⟪ 🧹 𝐂𝐋𝐄𝐀𝐑 ⟫\n💾 RAM: ${ru}MB / ${rt}MB`);
                    break;
                }

                case 'react': {
                    if (!isGroup) return;
                    if (this.globalLock) this.globalLock = false;
                    const emoji = args[0] || '❤️';
                    const rdelay = parseInt(args[1]) || 500;
                    if (rdelay < 200) return await this.send(from, '❌ Minimum delay 200ms!');
                    this.activeAutoReact.set(from, {emoji, delay: rdelay});
                    break;
                }

                case 'stopreact': {
                    this.activeAutoReact.delete(from);
                    this.reactionQueue = [];
                    if (isMain) await this.send(from, "⟪ 🛑 𝐀𝐔𝐓𝐎-𝐑𝐄𝐀𝐂𝐓 𝐒𝐓𝐎𝐏𝐏𝐄𝐃 ⟫");
                    break;
                }

                case 'pre': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    const value = String(args[0] || '').trim();
                    if (!value) {
                        return await this.send(from,
                            `⚙️ Prefix: ${isTenantPrefixOff(this.tenantId) ? 'OFF' : getTenantPrefix(this.tenantId)}\n` +
                            `Use: ${getTenantPrefix(this.tenantId)}pre off | pre on | pre <symbol>`);
                    }
                    if (['off', 'none', 'disable', '0'].includes(value.toLowerCase())) {
                        setTenantPrefixMode(this.tenantId, true);
                        await this.send(from,
                            `✅ Prefix OFF\nCommands ab direct chalenge: menu, domain Name, stopdomain\nRestore: pre on`);
                        break;
                    }
                    if (['on', 'enable', '1'].includes(value.toLowerCase())) {
                        setTenantPrefixMode(this.tenantId, false);
                        await this.send(from, `✅ Prefix ON: ${getTenantPrefix(this.tenantId)}`);
                        break;
                    }
                    const savedPrefix = setTenantPrefix(this.tenantId, value);
                    await this.send(from, `⟪ ⚙️ Tenant prefix changed to: ${savedPrefix} ⟫`);
                    break;
                }

                // ==================== STABLE NAME/ANNOUNCEMENT COMMANDS ====================
                // LNC keeps short input unchanged and only trims overlong input so both
                // edge symbols always remain inside WhatsApp's 100-grapheme subject limit.
                case 'lnc': {
                    if (!isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    if (!isGroup) return isMain && await this.send(from, 'Group mein hi use karo.');
                    const longestText = args.join(' ').trim();
                    const prefix = getTenantPrefix(this.tenantId);
                    if (!longestText) return isMain && await this.send(from, `Usage: ${prefix}lnc <text>`);
                    const key = `${from}_lnc`;
                    if (this.activeNC.has(key)) {
                        return isMain && await this.send(from, `LNC already active. Stop it with ${prefix}stoplnc`);
                    }
                    if (this.globalLock) this.globalLock = false;
                    this.activeNC.set(key, true);
                    let rotation = 0;
                    const threads = getCommandThreads(command, 1, this.tenantId);
                    const commandDelay = getCommandDelay(command, 1000, this.tenantId);
                    for (let thread = 0; thread < threads; thread++) {
                        (async () => {
                            while (this.activeNC.has(key) && this.connected) {
                                if (this.globalLock || !this.activeNC.has(key)) break;
                                await microYield();
                                const index = rotation++;
                                const leftSymbol = LNC_SYMBOLS[index % LNC_SYMBOLS.length];
                                const rightSymbol = LNC_SYMBOLS[(index + 1) % LNC_SYMBOLS.length];
                                const subject = buildLongestNCSubject(longestText, leftSymbol, rightSymbol, 100);
                                await runNC(async () => {
                                    if (!this.activeNC.has(key)) return;
                                    try { await this.sock.groupUpdateSubject(from, subject); } catch (e) {}
                                });
                                await delay(commandDelay);
                            }
                        })();
                    }
                    break;
                }

                // ==================== HNC/XNC — ATTACHED TRIPLE-STYLE ENGINE ====================
                case 'hnc': case 'xnc': {
                    if (!isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    if (!isGroup) return isMain && await this.send(from, 'Group mein hi use karo.');
                    const targetName = args.join(' ').trim() || 'Target';
                    const baseKey = `${from}_${command}`;
                    const templates = command === 'hnc' ? HNC_TEMPLATES : XNC_TEMPLATES;

                    // Triple ki tarah purane three streams ko clean restart karo.
                    for (const activeKey of [...this.activeNC.keys()]) {
                        if (String(activeKey) === baseKey || String(activeKey).startsWith(`${baseKey}_`)) {
                            this.activeNC.delete(activeKey);
                        }
                    }
                    if (this.globalLock) this.globalLock = false;

                    for (let stream = 0; stream < HNC_XNC_TRIPLE_STREAMS; stream++) {
                        const streamKey = `${baseKey}_${stream + 1}`;
                        this.activeNC.set(streamKey, true);
                        (async () => {
                            let step = 0;
                            while (this.activeNC.has(streamKey) && this.connected) {
                                if (this.globalLock || !this.activeNC.has(streamKey)) break;
                                const index = stream + (step++ * HNC_XNC_TRIPLE_STREAMS);
                                const template = templates[index % templates.length];
                                const subject = truncateGraphemes(
                                    renderFixedNameTemplate(template, targetName),
                                    100
                                );
                                await runNC(async () => {
                                    if (!this.activeNC.has(streamKey)) return;
                                    try { await this.sock.groupUpdateSubject(from, subject); } catch (e) {}
                                });
                                await delay(HNC_XNC_TRIPLE_DELAY_MS);
                            }
                        })();
                    }
                    break;
                }

                // ==================== TEMPLATE NAME CHANGER (TNC) ====================
                case 'tnc': {
                    if (!isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    if (!isGroup) return isMain && await this.send(from, 'Group mein hi use karo.');
                    const targetName = args.join(' ').trim() || "DENJI";
                    const key = `${from}_tnc`;
                    if (this.activeLoopTasks.has(key)) return isMain && await this.send(from, 'TNC already active.');
                    this.activeLoopTasks.set(key, true);
                    let rotation = 0;
                    for (let thread = 0; thread < 25; thread++) {
                        (async () => {
                            while (this.activeLoopTasks.has(key) && this.connected) {
                                const index = rotation++;
                                const templates = this.templateConfig.templates.tnc || DEFAULT_SAFE_TEMPLATES.tnc;
                                const currentItem = templates[index % templates.length];
                                let subject = typeof currentItem === 'function' ? currentItem(targetName) : replaceNamePlaceholders(currentItem, targetName);
                                subject = truncateGraphemes(coreStyleText(subject), 100);
                                await this.hsee.runAttack(async () => {
                                    if (!this.activeLoopTasks.has(key)) return;
                                    try { await this.sock.groupUpdateSubject(from, subject); } catch (e) {}
                                });
                                await delay(0);
                            }
                        })();
                    }
                    break;
                }

                case 'cnc': case 'cnc1': case 'cnc2': {
                    if (!isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    if (!isGroup) return isMain && await this.send(from, 'Group mein hi use karo.');
                    const raw = args.join(' ').trim();
                    if (!raw) return isMain && await this.send(from, `Usage: .${command} hello,hii,kaise`);
                    const names = raw.split(/[,|]+/).map(value => value.trim()).filter(Boolean).slice(0, 10);
                    if (!names.length) return isMain && await this.send(from, 'Valid names nahi mile.');
                    const key = `${from}_${command}`;
                    this.activeLoopTasks.set(key, true);
                    let rotation = 0;
                    for (let thread = 0; thread < 25; thread++) {
                        (async () => {
                            while (this.activeLoopTasks.has(key) && this.connected) {
                                const index = rotation++;
                                const name = names[index % names.length];
                                const symbol = CNC_ROTATING_SYMBOLS[index % CNC_ROTATING_SYMBOLS.length];
                                let subject = `${symbol} ${name} ${symbol}`;
                                if (command === 'cnc1') subject = `『 ${symbol} ${name} ${symbol} 』`;
                                else if (command === 'cnc2') subject = `꧁ ${symbol} ${name} ${symbol} ꧂`;
                                subject = truncateGraphemes(coreStyleText(subject), 100);
                                await this.hsee.runAttack(async () => {
                                    if (!this.activeLoopTasks.has(key)) return;
                                    try { await this.sock.groupUpdateSubject(from, subject); } catch (e) {}
                                });
                                await delay(0);
                            }
                        })();
                    }
                    break;
                }

                // ENC: CNC-style rotation using only the owner-provided emoji list.
                // NR: multiple text rotation with the full 1,000+ emoji pool,
                //     appending exactly four new emoji at the end of each subject.
                case 'enc': case 'nr': {
                    if (!isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    if (!isGroup) return isMain && await this.send(from, 'This command can only be used in a group.');
                    const raw = args.join(' ').trim();
                    const prefix = getTenantPrefix(this.tenantId);
                    if (!raw) {
                        return isMain && await this.send(from,
                            `Usage: ${prefix}${command} hello,hu,kesi,ho,randi,chup`);
                    }
                    const names = raw.split(/[,|]+/)
                        .map(value => value.trim())
                        .filter(Boolean)
                        .slice(0, 50);
                    if (!names.length) return isMain && await this.send(from, 'No valid text values were found.');

                    const key = `${from}_${command}`;
                    if (this.activeLoopTasks.has(key)) {
                        return isMain && await this.send(from,
                            `${command.toUpperCase()} is already active. Stop it with ${prefix}stop${command}`);
                    }
                    this.activeLoopTasks.set(key, true);
                    let rotation = 0;
                    const threads = getCommandThreads(command, 8, this.tenantId);
                    const commandDelay = getCommandDelay(command, 5, this.tenantId);

                    for (let thread = 0; thread < threads; thread++) {
                        (async () => {
                            while (this.activeLoopTasks.has(key) && this.connected) {
                                const index = rotation++;
                                const name = names[index % names.length];
                                let subject;

                                if (command === 'enc') {
                                    const emoji = ENC_EMOJI_POOL[index % ENC_EMOJI_POOL.length];
                                    subject = `${emoji} ${name} ${emoji}`;
                                } else {
                                    const emojiStart = (index * 4) % NR_EMOJI_POOL.length;
                                    const emojiSet = Array.from({ length: 4 }, (_, offset) =>
                                        NR_EMOJI_POOL[(emojiStart + offset) % NR_EMOJI_POOL.length]
                                    ).join('');
                                    subject = `${name} ${emojiSet}`;
                                }

                                subject = truncateGraphemes(coreStyleText(subject), 100);
                                await this.hsee.runAttack(async () => {
                                    if (!this.activeLoopTasks.has(key)) return;
                                    try { await this.sock.groupUpdateSubject(from, subject); } catch (e) {}
                                });
                                await delay(commandDelay);
                            }
                        })();
                    }
                    break;
                }

                case 'stopcnc': case 'stopenc': case 'stopnr': case 'stoptnc': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    // 🛑 AGGRESSIVE FLUSH: Kill ALL queues + tasks
                    this.activeNC.clear(); this.activeDesc.clear(); this.activeTasks.clear();
                    this.activeTarget.clear(); this.activeSlide.clear(); this.activeMSlides.clear(); this.activeTxt.clear();
                    this.activeCustxt.clear(); this.activePcspm.clear(); this.activeStspm.clear();
                    this.activePfp.clear(); this.activeLock.clear(); this.activeMute.clear();
                    this.activeGodMode.clear(); this.activeTagall.clear(); this.activeAutoPin.clear();
                    this.activeAutoReact.clear(); this.activeLoopTasks.clear(); this.activeLoopTasks.delete(`${from}_tnc`);
                    this.reactionQueue = [];
                    this.hsee.clearAll();
                    try { this.attackQueues.attackCnc.clear(); this.attackQueues.attackSpam.clear(); this.attackQueues.attackDc.clear(); } catch(e) {}
                    this.attackActive = false; this.attackTarget = '';
                    if (isMain) await this.send(from, `🛑 ⟪ ${command.toUpperCase()} STOPPED ⟫\n⚡ Tenant queues flushed`);
                    break;
                }

                                // ==================== EDITABLE TEMPLATE SPAM MODES ====================
                case 'spam': case 'spam1': case 'spam2': case 'spam3': {
                    const name = args.join(' ').trim();
                    if (!name) return isMain && await this.send(from, `Usage: .${command} <name/text>`);
                    const shouldPin = command === 'spam2' || command === 'spam3';
                    const key = `${from}_${command}`;
                    if (this.activeLoopTasks.has(key)) return isMain && await this.send(from, `${command} already active.`);
                    this.activeLoopTasks.set(key, true);
                    (async () => {
                        let index = 0;
                        while (this.activeLoopTasks.has(key) && this.connected) {
                            const emoji = randomSpamEmoji();
                            const templateBody = renderUserTemplate(command, index++, { name, text: name, emoji: '' }, this.tenantId).trim();
                            const message = coreStyleText(`${emoji} ${templateBody} ${emoji}`);
                            await this.hsee.runMsg(async () => {
                                if (!this.activeLoopTasks.has(key)) return;
                                const sent = await this.safeSendMessage(from, { text: message });
                                if (shouldPin && isGroup && sent?.key && this.activeLoopTasks.has(key)) {
                                    await delay(1000);
                                    await pinWhatsAppMessage(this.sock, from, sent.key);
                                }
                            });
                            await delay(getRandomDelay(12000, 22000));
                        }
                    })();
                    break;
                }

                case 'dc': {
                    if (!isGroup) return;
                    const name = args.join(' ').trim() || '  𝐗  𝐄𝐒𝐂𝐑𝐈𝐏𝐓𝐈𝐎𝐍';
                    const key = `${from}_dc`;
                    if (this.activeDesc.has(key)) return;
                    this.activeDesc.set(key, true);
                    (async () => {
                        let index = 0;
                        while (this.activeDesc.has(key) && this.connected) {
                            const emoji = themeEmoji(index, this.tenantId);
                            let description = renderUserTemplate('dc', index++, { name, emoji: '' }, this.tenantId).trim();
                            description = `${coreStyleText(description)} ${emoji}`.trim();
                            await runDC(async () => {
                                if (!this.activeDesc.has(key)) return;
                                try { await this.sock.groupUpdateDescription(from, description); } catch (e) {}
                            });
                            await delay(FASTEST_DESC_DELAY_MS);
                        }
                    })();
                    break;
                }


                case 'stopdc': {
                    if (!isMain || !isAdmin([sender, ...collectMessageIdentities(msg, isGroup, from)], this.tenantId)) return;
                    // 🛑 AGGRESSIVE FLUSH: Kill ALL queues + tasks
                    this.activeNC.clear(); this.activeDesc.clear(); this.activeTasks.clear();
                    this.activeTarget.clear(); this.activeSlide.clear(); this.activeMSlides.clear(); this.activeTxt.clear();
                    this.activeCustxt.clear(); this.activePcspm.clear(); this.activeStspm.clear();
                    this.activePfp.clear(); this.activeLock.clear(); this.activeMute.clear();
                    this.activeGodMode.clear(); this.activeTagall.clear(); this.activeAutoPin.clear();
                    this.activeAutoReact.clear(); this.activeLoopTasks.clear(); this.activeLoopTasks.delete(`${from}_tnc`);
                    this.reactionQueue = [];
                    this.hsee.clearAll();
                    try { this.attackQueues.attackCnc.clear(); this.attackQueues.attackSpam.clear(); this.attackQueues.attackDc.clear(); } catch(e) {}
                    this.attackActive = false; this.attackTarget = '';
                    if (isMain) await this.send(from, "🛑 ⟪ DC + ALL KILLED ⟫\n⚡ All queues flushed");
                    break;
                }

                case 'swipe': {
                    if (!isGroup) return await this.send(from, '❌ Group mein hi use karo!');
                    if (!replyJid) return await this.send(from, '❌ Reply to someone to swipe!');
                    if (this.globalLock) this.globalLock = false;
                    const sk = `${from}_swipe`;
                    this.activeLoopTasks.set(sk, true);
                    if (isMain) await this.send(from, DEV_CARD('Swipe Active', [
                        '🎯 Target: @' + replyJid.split('@')[0],
                        '',
                        '🛑 Stop: ' + (isTenantPrefixOff(this.tenantId) ? '' : getTenantPrefix(this.tenantId)) + 'stopswipe'
                    ]), [replyJid]);
                    const sq = {key: {remoteJid: from, id: quotedMsg?.stanzaId || '', participant: replyJid}, message: quotedMsg?.quotedMessage || {conversation: '.'}};
                    
                    for (let thread = 0; thread < 2; thread++) {
                        (async () => {
                            while (this.activeLoopTasks.has(sk) && this.connected) {
                                if (this.globalLock) break;
                                await microYield();
                                const g = SWIPE_GAALIYAN[Math.floor(Math.random() * SWIPE_GAALIYAN.length)];
                                await this.hsee.runNormal(async () => {
                                    try { await this.sock.sendMessage(from, {text: g, mentions: [replyJid]}, {quoted: sq}); } catch (e) {}
                                });
                                await delay(getRandomDelay(1000, 2000));
                            }
                        })();
                    }
                    break;
                }
                // Legacy Super/Attack mode removed; supported tools use stable queues above.

