// ==================== 🛰️ MULTI-TENANT BOT MANAGER ====================
const MAX_GLOBAL_BOTS = 50;
// There is intentionally no per-user bot limit; only the global capacity applies.
// Disconnected, crashed, logged-out or suspended sessions get one recovery window.
// Reconnect attempts never extend this deadline. Default: exactly 12 hours.
const configuredAutoDeleteHours = Number(process.env.BOT_AUTO_DELETE_HOURS || 12);
const AUTO_DELETE_HOURS = Number.isFinite(configuredAutoDeleteHours) && configuredAutoDeleteHours >= 1
    ? configuredAutoDeleteHours
    : 12;
const AUTO_DELETE_AFTER_MS = AUTO_DELETE_HOURS * 60 * 60 * 1000;
const AUTO_DELETE_PERMANENT_MS = AUTO_DELETE_AFTER_MS;
const AUTO_DELETE_OFFLINE_MS = AUTO_DELETE_AFTER_MS;

class BotManager {
    constructor() {
        this.bots = new Map(); // key: <telegramUserId>::<Bot_N>
        this.tenantCounters = {};
        this.tenantEngines = new Map();
        this.connectionSequence = 0;
        this.workerDispatchQueue = new PQueue({ concurrency: 12 });
        this.pairingQueue = new PQueue({ concurrency: 1 });
        this.cleanupTimers = new Map();
        this.telegramControl = null;
    }

    normalizeTenantId(tenantId) {
        return String(tenantId || DEFAULT_TENANT_ID).replace(/[^0-9A-Za-z_-]/g, '_');
    }

    sessionKey(tenantId, botId) {
        return `${this.normalizeTenantId(tenantId)}::${botId}`;
    }

    getTenantEngine(tenantId) {
        const tenant = this.normalizeTenantId(tenantId);
        if (!this.tenantEngines.has(tenant)) this.tenantEngines.set(tenant, createTenantQueueEngine());
        return this.tenantEngines.get(tenant);
    }

    getTenantBots(tenantId) {
        const tenant = this.normalizeTenantId(tenantId);
        return [...this.bots.values()].filter(bot => bot.tenantId === tenant);
    }

    getTenantBot(tenantId, botId) {
        return this.bots.get(this.sessionKey(tenantId, botId)) || null;
    }

    getTenantIds() {
        return [...new Set([...this.bots.values()].map(bot => bot.tenantId))];
    }

    getStoredTenantIds() {
        const ids = new Set(this.getTenantIds());
        try {
            fs.mkdirSync(USER_DATA_ROOT, { recursive: true });
            for (const name of fs.readdirSync(USER_DATA_ROOT)) {
                const full = `${USER_DATA_ROOT}/${name}`;
                if (fs.statSync(full).isDirectory()) ids.add(this.normalizeTenantId(name));
            }
        } catch (e) {}
        return [...ids];
    }

    getMainBotId(tenantId = DEFAULT_TENANT_ID) {
        const bots = this.getTenantBots(tenantId)
            .sort((a, b) => Number(a.internalId.split('_')[1]) - Number(b.internalId.split('_')[1]));
        return bots.find(bot => bot.internalId === 'Bot_1')?.internalId || bots[0]?.internalId || 'Bot_1';
    }

    getMainBot(tenantId = DEFAULT_TENANT_ID) {
        return this.getTenantBot(tenantId, this.getMainBotId(tenantId));
    }

    disconnectReason(code) {
        const reasons = {
            401: 'Logged out / authentication revoked',
            403: 'Account access forbidden or suspended',
            408: 'Connection timed out or was lost',
            411: 'Multi-device session mismatch',
            428: 'Connection was closed',
            440: 'Session replaced by another connection',
            500: 'Bad session or internal connection failure',
            503: 'WhatsApp service unavailable',
            515: 'WhatsApp restart required'
        };
        return reasons[Number(code)] || `Unknown disconnect (${code})`;
    }

    isPermanentDisconnect(code) {
        return [401, 403, 411, 440, 500].includes(Number(code));
    }

    clearCleanupTimer(sessionKey) {
        const timer = this.cleanupTimers.get(sessionKey);
        if (timer) clearTimeout(timer);
        this.cleanupTimers.delete(sessionKey);
    }

    handleSessionState(session, event) {
        if (!session || session.destroyed || session.manualRemoval) return;
        if (event.state === 'open') {
            const shouldNotifyRecovery = session.disconnectAlertSent && !session.pairingPending;
            const previous = {
                offlineSince: session.offlineSince,
                code: session.lastDisconnectCode,
                reason: session.lastDisconnectReason
            };
            this.clearCleanupTimer(session.sessionKey);
            session.offlineSince = null;
            session.lastDisconnectCode = null;
            session.lastDisconnectReason = null;
            session.autoDeleteAt = null;
            session.disconnectAlertSent = false;
            this.saveTenantBots(session.tenantId);
            if (shouldNotifyRecovery) {
                this.telegramControl?.sendSessionLifecycle(session, 'recovered', previous).catch(() => {});
            }
            return;
        }

        if (event.state !== 'close' || session.pairingPending) {
            this.saveTenantBots(session.tenantId);
            return;
        }

        const permanent = this.isPermanentDisconnect(event.code);
        const defaultGraceMs = permanent ? AUTO_DELETE_PERMANENT_MS : AUTO_DELETE_OFFLINE_MS;
        session.offlineSince ||= Date.now();
        session.lastDisconnectCode = Number(event.code) || 500;
        session.lastDisconnectReason = event.reason || this.disconnectReason(event.code);
        // Reconnect attempts must not keep extending the cleanup deadline.
        const candidateDeadline = session.offlineSince + defaultGraceMs;
        if (!session.autoDeleteAt || (permanent && session.autoDeleteAt > candidateDeadline)) {
            session.autoDeleteAt = candidateDeadline;
        }
        const remainingMs = Math.max(1000, session.autoDeleteAt - Date.now());
        this.clearCleanupTimer(session.sessionKey);

        const timer = setTimeout(async () => {
            const current = this.getTenantBot(session.tenantId, session.internalId);
            if (!current || current.connected || current.destroyed) return;
            const details = {
                offlineSince: current.offlineSince,
                code: current.lastDisconnectCode,
                reason: current.lastDisconnectReason,
                autoDeleteAt: current.autoDeleteAt
            };
            this.removeSession(current.tenantId, current.internalId, true);
            await this.telegramControl?.sendSessionLifecycle(current, 'autoDeleted', details).catch(() => {});
        }, remainingMs);
        timer.unref?.();
        this.cleanupTimers.set(session.sessionKey, timer);
        this.saveTenantBots(session.tenantId);

        if (!session.disconnectAlertSent) {
            session.disconnectAlertSent = true;
            this.saveTenantBots(session.tenantId);
            this.telegramControl?.sendSessionLifecycle(session, permanent ? 'permanent' : 'disconnected', {
                offlineSince: session.offlineSince,
                code: session.lastDisconnectCode,
                reason: session.lastDisconnectReason,
                autoDeleteAt: session.autoDeleteAt
            }).catch(() => {});
        }
    }

    serializeBot(bot) {
        return {
            id: bot.internalId,
            phone: bot.phoneNumber,
            offlineSince: bot.offlineSince,
            lastDisconnectCode: bot.lastDisconnectCode,
            lastDisconnectReason: bot.lastDisconnectReason,
            autoDeleteAt: bot.autoDeleteAt
        };
    }

    saveTenantBots(tenantId) {
        const tenant = this.normalizeTenantId(tenantId);
        const bots = this.getTenantBots(tenant)
            .sort((a, b) => Number(a.internalId.split('_')[1]) - Number(b.internalId.split('_')[1]));
        safeWriteJSON(userDataPath(tenant, 'bots.json'), {
            version: 3,
            ownerId: tenant,
            counter: Number(this.tenantCounters[tenant]) || 1,
            limits: { global: MAX_GLOBAL_BOTS, perUser: null, policy: 'GLOBAL_ONLY' },
            bots: bots.map(bot => this.serializeBot(bot))
        });
    }

    migrateAuthDirectory(tenantId, botId) {
        const tenant = this.normalizeTenantId(tenantId);
        const target = userDataPath(tenant, `sessions/${botId}`);
        if (fs.existsSync(target) && fs.readdirSync(target).length > 0) return target;
        const candidates = [
            `./auth/${tenant}/${botId}`,
            `./auth/${botId}`
        ];
        try {
            const source = candidates.find(path => fs.existsSync(path));
            if (source && source !== target) {
                fs.mkdirSync(target.split('/').slice(0, -1).join('/'), { recursive: true });
                try { fs.renameSync(source, target); }
                catch (e) { fs.cpSync(source, target, { recursive: true }); }
            }
        } catch (error) {
            console.error(`[AUTH MIGRATION ${tenant}/${botId}]`, error.message);
        }
        return target;
    }

    migrateLegacyBotIndex(defaultOwner) {
        const legacy = safeReadJSON(BOTS_FILE, { version: 2, counters: {}, bots: [] });
        const entries = Array.isArray(legacy.bots) ? legacy.bots : [];
        const groups = new Map();
        for (const entry of entries) {
            if (!entry?.id || !entry?.phone) continue;
            const tenant = this.normalizeTenantId(entry.ownerId || entry.tenantId || defaultOwner);
            if (!groups.has(tenant)) groups.set(tenant, []);
            groups.get(tenant).push(entry);
        }
        for (const [tenant, bots] of groups) {
            const file = userDataPath(tenant, 'bots.json');
            if (!fs.existsSync(file)) {
                const maxId = Math.max(1, ...bots.map(bot => Number(String(bot.id).split('_')[1]) || 1));
                safeWriteJSON(file, {
                    version: 3,
                    ownerId: tenant,
                    counter: Number(legacy.counters?.[tenant]) || maxId,
                    limits: { global: MAX_GLOBAL_BOTS, perUser: null, policy: 'GLOBAL_ONLY' },
                    bots: bots.map(bot => ({
                        id: bot.id,
                        phone: bot.phone,
                        offlineSince: bot.offlineSince || null,
                        lastDisconnectCode: bot.lastDisconnectCode || null,
                        lastDisconnectReason: bot.lastDisconnectReason || null,
                        autoDeleteAt: bot.autoDeleteAt || null
                    }))
                });
            }
            for (const bot of bots) this.migrateAuthDirectory(tenant, bot.id);
        }
        return [...groups.keys()];
    }

    async init() {
        const defaultOwner = this.normalizeTenantId(this.telegramControl?.access?.ownerId || DEFAULT_TENANT_ID);
        const migratedTenants = this.migrateLegacyBotIndex(defaultOwner);
        const tenantIds = new Set(migratedTenants);
        try {
            fs.mkdirSync(USER_DATA_ROOT, { recursive: true });
            for (const name of fs.readdirSync(USER_DATA_ROOT)) {
                const full = `${USER_DATA_ROOT}/${name}`;
                if (fs.statSync(full).isDirectory()) tenantIds.add(this.normalizeTenantId(name));
            }
        } catch (e) {}

        let totalSaved = 0;
        for (const tenantId of tenantIds) {
            const data = safeReadJSON(userDataPath(tenantId, 'bots.json'), { version: 3, counter: 1, bots: [] });
            const entries = Array.isArray(data.bots) ? data.bots : [];
            if (!entries.length) continue;
            totalSaved += entries.length;
            this.tenantCounters[tenantId] = Math.max(
                Number(data.counter) || 1,
                ...entries.map(entry => Number(String(entry.id).split('_')[1]) || 1)
            );
            console.log(`🔐 Loading user console ${tenantId}: ${entries.length} session(s)`);
            for (const entry of entries) {
                if (!entry?.id || !entry?.phone) continue;
                this.migrateAuthDirectory(tenantId, entry.id);
                const session = new BotSession(entry.id, entry.phone, this, false, tenantId);
                session.offlineSince = Number(entry.offlineSince) || null;
                session.lastDisconnectCode = Number(entry.lastDisconnectCode) || null;
                session.lastDisconnectReason = entry.lastDisconnectReason || null;
                session.autoDeleteAt = Number(entry.autoDeleteAt) || null;
                this.bots.set(session.sessionKey, session);
                try { await session.connect(); }
                catch (error) { console.error(`[User ${tenantId} / ${entry.id}] reconnect failed:`, error.message); }
                await delay(750);
            }
        }

        if (totalSaved > 0) {
            console.log(`\n🔄 Reconnecting ${totalSaved} isolated WhatsApp session(s)...`);
            this.refreshRulerState();
            this.save();
        } else {
            console.log('\n📲 No WhatsApp sessions are paired. Use /addbot 91XXXXXXXXXX in Telegram.');
            console.log('   Terminal phone/QR pairing is disabled.');
            this.save();
        }
    }

    allocateBotId(tenantId) {
        const tenant = this.normalizeTenantId(tenantId);
        const used = new Set(this.getTenantBots(tenant).map(bot => bot.internalId));
        if (!used.has('Bot_1')) {
            this.tenantCounters[tenant] = Math.max(1, Number(this.tenantCounters[tenant]) || 1);
            return 'Bot_1';
        }
        let next = Math.max(2, (Number(this.tenantCounters[tenant]) || 1) + 1);
        while (used.has(`Bot_${next}`)) next++;
        this.tenantCounters[tenant] = next;
        return `Bot_${next}`;
    }

    async createPairingSession(phone, tenantId, onConnectionState = null) {
        const tenant = this.normalizeTenantId(tenantId);
        const cleanPhone = String(phone || '').replace(/\D/g, '');
        if (!/^\d{8,15}$/.test(cleanPhone)) {
            throw new Error('Enter a valid 8-15 digit phone number with country code. Example: 919876543210');
        }

        return await this.pairingQueue.add(async () => {
            if (this.bots.size >= MAX_GLOBAL_BOTS) {
                throw new Error(this.telegramControl?.isOwner(tenant)
                    ? `Global capacity reached (${MAX_GLOBAL_BOTS}/${MAX_GLOBAL_BOTS}).`
                    : 'The platform is currently at capacity. Contact the owner.');
            }
            const tenantBots = this.getTenantBots(tenant);
            const foreignOwner = [...this.bots.values()].find(bot =>
                bot.tenantId !== tenant && String(bot.phoneNumber || '').replace(/\D/g, '') === cleanPhone);
            if (foreignOwner) {
                throw new Error('This phone number cannot be registered in your console.');
            }
            const botId = this.allocateBotId(tenant);
            const session = new BotSession(botId, cleanPhone, this, false, tenant);
            session.pairingPending = true;
            const staleAuthPath = session.authPath;
            try { if (fs.existsSync(staleAuthPath)) fs.rmSync(staleAuthPath, { recursive: true, force: true }); } catch (e) {}

            const removeObserver = typeof onConnectionState === 'function'
                ? session.onConnectionState(onConnectionState)
                : () => {};
            this.bots.set(session.sessionKey, session);
            this.save();

            try {
                await session.connect();
                await delay(3000);
                if (!session.sock) throw new Error('The WhatsApp socket could not be initialized.');
                const code = await Promise.race([
                    session.sock.requestPairingCode(cleanPhone),
                    new Promise((_, reject) => setTimeout(() => reject(new Error('Pairing-code request timed out.')), 30000))
                ]);
                if (!code) throw new Error('WhatsApp did not return a pairing code.');
                this.save();
                return { botId, tenantId: tenant, phone: cleanPhone, code: String(code), session, removeObserver };
            } catch (error) {
                removeObserver();
                session.destroyed = true;
                try { session.sock?.ev?.removeAllListeners(); } catch (e) {}
                try { session.sock?.end?.(); } catch (e) {}
                this.bots.delete(session.sessionKey);
                try { if (fs.existsSync(staleAuthPath)) fs.rmSync(staleAuthPath, { recursive: true, force: true }); } catch (e) {}
                this.save();
                throw error;
            }
        });
    }

    removeSession(tenantId, botId, removeAuth = false) {
        const tenant = this.normalizeTenantId(tenantId);
        const key = this.sessionKey(tenant, botId);
        const session = this.bots.get(key);
        if (!session) return false;
        this.clearCleanupTimer(session.sessionKey);
        session.manualRemoval = true;
        session.destroyed = true;
        try { session.sock?.ev?.removeAllListeners(); } catch (e) {}
        try { session.sock?.end?.(); } catch (e) {}
        this.bots.delete(key);
        if (removeAuth) {
            try { if (fs.existsSync(session.authPath)) fs.rmSync(session.authPath, { recursive: true, force: true }); } catch (e) {}
        }
        this.save();
        this.refreshRulerState(tenant);
        if (this.getTenantBots(tenant).length === 0) {
            try { this.tenantEngines.get(tenant)?.clearAll?.(); } catch (e) {}
            this.tenantEngines.delete(tenant);
        }
        return true;
    }

    refreshRulerState(tenantId = null) {
        const tenantIds = tenantId ? [this.normalizeTenantId(tenantId)] : this.getTenantIds();
        for (const tenant of tenantIds) {
            const all = this.getTenantBots(tenant);
            if (!getTenantRulerMode(tenant)) {
                for (const bot of all) bot.runtimeEnabled = true;
                continue;
            }
            const main = this.getMainBot(tenant);
            const primaryPhone = String(main?.phoneNumber || main?.sock?.user?.id?.split(':')[0] || '').replace(/\D/g, '');
            const sameNumber = all
                .filter(bot => String(bot.phoneNumber || bot.sock?.user?.id?.split(':')[0] || '').replace(/\D/g, '') === primaryPhone)
                .sort((a, b) => Number(a.internalId.split('_')[1]) - Number(b.internalId.split('_')[1]));
            const allowed = new Set(sameNumber.slice(0, 4).map(bot => bot.internalId));
            allowed.add(this.getMainBotId(tenant));
            for (const bot of all) bot.runtimeEnabled = allowed.has(bot.internalId);
        }
    }

    save() {
        const runtimeTenants = new Set(this.getTenantIds());
        try {
            fs.mkdirSync(USER_DATA_ROOT, { recursive: true });
            for (const name of fs.readdirSync(USER_DATA_ROOT)) {
                const full = `${USER_DATA_ROOT}/${name}`;
                if (fs.statSync(full).isDirectory()) runtimeTenants.add(this.normalizeTenantId(name));
            }
        } catch (e) {}
        for (const tenant of runtimeTenants) this.saveTenantBots(tenant);
        const index = {
            version: 3,
            storage: 'PER_USER_ID_DIRECTORIES',
            globalLimit: MAX_GLOBAL_BOTS,
            totalSessions: this.bots.size,
            tenants: [...runtimeTenants].sort()
        };
        safeWriteJSON(USER_INDEX_FILE, index);
        // Keep only a migration marker globally; phone numbers live in users/<id>/bots.json.
        safeWriteJSON(BOTS_FILE, { version: 3, migrated: true, storage: 'PER_USER_ID_DIRECTORIES' });
    }
}

