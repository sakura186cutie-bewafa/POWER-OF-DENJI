                    const pt = pa.join(" ");
                    if (!pt) return isMain && await this.send(from, "⟪ ⚠️ Text required! ⟫");
                    const ptk = `${from}_pinspm`;
                    if (this.activeTasks.has(ptk)) return;
                    this.activeTasks.set(ptk, true);
                    if (isMain) {
                        const sl = cpd ? `${cpd}ms` : "15s - 25s Random";
                        await this.send(from, `⟪ ?? PIN SPAM ⟫\n➪ Text: ${styleText(pt)}\n➪ Delay: ${sl}`);
                    }
                    (async () => {
                        let lpt = 0;
                        while (this.activeTasks.has(ptk)) {
                            if (this.globalLock || !this.connected || !this.activeTasks.has(ptk)) break;
                            const n = Date.now();
                            if (n - lpt < 10000) { await delay(1000); continue; }
                            await microYield();
                                                        try {
                                const ft = `${getRandom(specialSymbols)} ${pt} ${getRandom(specialSymbols)}`;
                                await runSpam(async () => {
                                    if (!this.activeTasks.has(ptk)) return;
                                    const sm = await this.sock.sendMessage(from, {text: `*${styleText(ft)}*`});
                                    if (sm && sm.key) {
                                        await delay(2000); // 2 sec wait karega taaki message server pe chala jaye
                                        if (!this.activeTasks.has(ptk)) return;
                                        await pinWhatsAppMessage(this.sock, from, sm.key, 604800, 8000);
                                        lpt = Date.now();
                                    }
                                });
                            } catch (e) {}
                            const wt = cpd || getRandomDelay(15000, 25000);
                            await delay(wt);
                        }
                    })();
                    break;
                }

                case 'stoppinspm': {
                    this.activeTasks.delete(`${from}_pinspm`);
                    this.hsee.clearAll();
                    if (isMain) await this.send(from, `⟪ 🛑 PIN SPAM STOPPED ⟫`);
