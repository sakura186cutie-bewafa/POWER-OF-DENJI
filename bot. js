function splitTTSChunks(text, maxLength = 180) {
    const words = String(text || '').trim().split(/\s+/).filter(Boolean);
    const chunks = [];
    let current = '';
    for (const word of words) {
        if ((current + ' ' + word).trim().length > maxLength && current) {
            chunks.push(current);
            current = word;
        } else current = (current ? `${current} ${word}` : word);
    }
    if (current) chunks.push(current);
    return chunks.slice(0, 10);
}
function looksLikeAudio(buffer, contentType = '') {
    if (!Buffer.isBuffer(buffer) || buffer.length < 500) return false;
    if (/audio|mpeg|mp3|octet-stream/i.test(contentType)) return true;
    return buffer.slice(0, 3).toString('ascii') === 'ID3'
        || (buffer[0] === 0xff && (buffer[1] & 0xe0) === 0xe0)
        || buffer.slice(0, 4).toString('ascii') === 'OggS';
}
async function fetchTTSChunk(text, language = 'hi') {
    const query = encodeURIComponent(text);
    const urls = [
        `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${language}&q=${query}`,
        `https://translate.google.co.in/translate_tts?ie=UTF-8&client=tw-ob&tl=${language}&q=${query}`,
        `https://translate.googleapis.com/translate_tts?ie=UTF-8&client=gtx&tl=${language}&q=${query}`
    ];
    const errors = [];
    for (const url of urls) {
        try {
            const response = await fetch(url, {
                headers: {
                    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124 Safari/537.36',
                    'Accept': 'audio/mpeg,audio/*;q=0.9,*/*;q=0.1',
                    'Referer': 'https://translate.google.com/'
                },
                signal: AbortSignal.timeout(20000)
            });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const buffer = Buffer.from(await response.arrayBuffer());
            if (!looksLikeAudio(buffer, response.headers.get('content-type') || '')) throw new Error('invalid audio response');
            return buffer;
        } catch (e) { errors.push(e.message); }
    }
    throw new Error(`TTS providers failed: ${errors.join(', ')}`);
}
async function generateTTS(text, language = 'hi') {
    const clean = String(text || '').trim();
    if (!clean) throw new Error('TTS text empty hai');
    if (clean.length > 1500) throw new Error('TTS text maximum 1500 characters hai');
    const chunks = splitTTSChunks(clean);
    const audioParts = [];
    for (const chunk of chunks) audioParts.push(await fetchTTSChunk(chunk, language));
    const output = Buffer.concat(audioParts);
    if (!looksLikeAudio(output, 'audio/mpeg')) throw new Error('Generated TTS audio invalid hai');
    return output;
}

// Baileys expects a full PinMessage object, not `{ pin: messageKey }`.
// type: 1 pins the message and time is expressed in seconds (7 days here).
async function pinWhatsAppMessage(sock, jid, messageKey, durationSeconds = 604800, timeoutMs = 8000) {
    if (!sock || !jid || !messageKey?.id) return false;
    let timer = null;
    try {
        const timeout = new Promise((_, reject) => {
            timer = setTimeout(() => reject(new Error('Pin request timed out')), timeoutMs);
        });
        await Promise.race([
            sock.sendMessage(jid, {
                pin: {
                    type: 1,
                    time: durationSeconds,
                    key: messageKey
                }
            }),
            timeout
        ]);
        return true;
    } catch (error) {
        console.error(`[PIN ERROR ${jid}]`, error?.message || error);
        return false;
    } finally {
        if (timer) clearTimeout(timer);
    }
}

